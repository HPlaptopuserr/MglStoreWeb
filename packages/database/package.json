{
  "name": "@mgl/database",
  "version": "0.0.0",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "db:generate": "node scripts/with-root-env.cjs prisma generate",
    "db:migrate": "node scripts/with-root-env.cjs prisma migrate dev",
    "db:studio": "node scripts/with-root-env.cjs prisma studio",
    "db:seed": "node scripts/with-root-env.cjs ts-node prisma/seed.ts",
    "db:seed-categories": "node scripts/with-root-env.cjs ts-node prisma/seed-categories.ts",
    "db:validate": "node scripts/with-root-env.cjs prisma validate",
    "db:format": "node scripts/with-root-env.cjs prisma format"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.34",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
