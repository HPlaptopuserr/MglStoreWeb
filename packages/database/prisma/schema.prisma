  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  user           User?                           @relation("MembershipAgentUser", fields: [userId], references: [id])
  createdBy      User?                           @relation("MembershipAgentCreatedBy", fields: [createdById], references: [id])
  registrations  AssociationMemberRegistration[]
  commissions    MembershipReferralCommission[]

