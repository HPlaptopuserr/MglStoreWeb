/// Goods received directly for POS sale, separately from warehouse receiving.
/// Every item is an inventory lot so different expiry dates are never overwritten.
model PosGoodsReceipt {
  id                 String                @id @default(uuid())
  receiptNo          String                @unique
  organizationId     String
  branchId           String
  registerId         String
  receivedById       String
  supplierName       String
  supplierRegisterNo String?
  documentNo         String?
  note               String?
  receivedAt         DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id])
  branch             Branch                @relation(fields: [branchId], references: [id])
  register           PosRegister           @relation(fields: [registerId], references: [id])
  receivedBy         User                  @relation("PosGoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  items              PosGoodsReceiptItem[]
  version            Int                   @default(1)
  mergedIntoId       String?
  mergedInto         PosGoodsReceipt?      @relation("ReceiptMerge", fields: [mergedIntoId], references: [id])
  mergedReceipts     PosGoodsReceipt[]     @relation("ReceiptMerge")
  revisions          PosGoodsReceiptRevision[]

  @@index([organizationId, receivedAt])
  @@index([branchId, receivedAt])
  @@index([registerId, receivedAt])
  @@index([receivedById, receivedAt])
}

/// A separately tracked batch/lot from one POS goods receipt.
model PosGoodsReceiptItem {
  id                String                      @id @default(uuid())
  receiptId         String
  productId         String
  quantity          Int
  remainingQuantity Int
  unitCost          Decimal?                    @db.Decimal(18, 2)
  batchNumber       String?
  expiryDate        DateTime?                   @db.Date
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  receipt           PosGoodsReceipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product           Product                     @relation(fields: [productId], references: [id])
  allocations       PosGoodsReceiptAllocation[]

  @@index([receiptId])
  @@index([productId, expiryDate])
  @@index([productId, remainingQuantity, expiryDate])
  @@index([batchNumber])
}

/// Records which receipt lot a POS sale consumed so a void restores the exact lot.
model PosGoodsReceiptAllocation {
  id            String              @id @default(uuid())
  receiptItemId String
  referenceId   String
  referenceType String
  quantity      Int
  unitCost      Decimal?            @db.Decimal(18, 2)
  totalCost     Decimal?            @db.Decimal(18, 2)
  createdAt     DateTime            @default(now())
  reversedAt    DateTime?
  receiptItem   PosGoodsReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Cascade)

  @@index([receiptItemId])
  @@index([referenceType, referenceId])
  @@index([referenceType, referenceId, reversedAt])
}

/// Structured POS sale record.
model PosSale {
  id                    String                 @id @default(uuid())
  receiptNo             String                 @unique
  organizationId        String
  branchId              String
  registerId            String?
  shiftId               String
  cashierId             String
  cafeRegularCustomerId String?
  status                PosSaleStatus          @default(COMPLETED)
  paymentMethod         String
  paymentBreakdown      Json?
  subtotal              Decimal                @db.Decimal(18, 2)
  taxTotal              Decimal                @db.Decimal(18, 2)
  discountTotal         Decimal                @db.Decimal(18, 2)
  grandTotal            Decimal                @db.Decimal(18, 2)
  note                  String?
  ebarimtStatus         String?
  ebarimtBillId         String?
  ebarimtReceiptId      String?
  ebarimtQrData         String?
  ebarimtLottery        String?
  ebarimtDate           DateTime?
  ebarimtError          String?
  ebarimtPayload        Json?
  ebarimtSyncedAt       DateTime?
  voidedAt              DateTime?
  voidReason            String?
  voidedById            String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id])
  branch                Branch                 @relation(fields: [branchId], references: [id])
  register              PosRegister?           @relation(fields: [registerId], references: [id])
  shift                 PosShift               @relation(fields: [shiftId], references: [id])
  cashier               User                   @relation("PosSaleCashier", fields: [cashierId], references: [id])
