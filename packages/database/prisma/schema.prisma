  city           String?
  district       String?
  khoroo         String?
  entrance       String?
  apartment      String?
  lat            Float?
  lng            Float?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
