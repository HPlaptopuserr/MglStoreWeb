  slug            String           @unique
  parentId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryHierarchy")
  products        Product[]
  productRequests ProductRequest[]

  @@index([parentId])
}

model Product {
  warehouseRetailItems WarehouseRetailOrderItem[]
  sentTransferItems WarehouseTransferItem[] @relation("TransferSourceProduct")
  receivedTransferItems WarehouseTransferItem[] @relation("TransferTargetProduct")
  stocktakeLines StocktakeLine[]

  id                     String                        @id @default(uuid())
  organizationId         String?
  masterProductId        String?
  managedByWarehouseId   String?
  submittedById          String?
  reviewedById           String?
  name                   String
  description            String?
  specifications         Json?
  sku                    String?
  barcode                String?
  barcodeAliases         String[]                      @default([])
  unit                   String?
  price                  Decimal                       @db.Decimal(18, 2)
  wholesalePrice         Decimal?                      @db.Decimal(18, 2)
  orderPrice             Decimal?                      @db.Decimal(18, 2)
  costPrice              Decimal?                      @db.Decimal(18, 2)
  /// Denormalized cache. Canonical stock lives in WarehouseInventory.quantity.
  /// Updated by POS sales and inventory operations. Do not treat as source of truth
  /// when warehouse management is active for this product.
  stock                  Int                           @default(0)
  lowStockThreshold      Decimal                       @default(5) @db.Decimal(18, 3)
  taxType                String                        @default("VAT_ABLE")
  cityTaxRate            Decimal                       @default(0) @db.Decimal(5, 2)
  classificationCode     String                        @default("6212991")
  taxProductCode         String?
  isRestaurantMenuItem   Boolean                       @default(false)
  isTakeawayAvailable    Boolean                       @default(true)
  takeawayPackagingFee   Decimal                       @default(0) @db.Decimal(18, 2)
  isSoldByPiece          Boolean                       @default(false)
  pieceSmallPackSize     Int                           @default(3)
  pieceSmallPackFee      Decimal                       @default(300) @db.Decimal(18, 2)
  pieceLargePackSize     Int                           @default(6)
  pieceLargePackFee      Decimal                       @default(800) @db.Decimal(18, 2)
  menuCategory           String?
  kitchenStation         String?
  preparationMinutes     Int?
  supplyType             ProductSupplyType             @default(IN_STOCK)
  preorderLeadTimeDays   Int?
  preorderCapacity       Int?
  preorderCycleStartedAt DateTime?
  preorderNote           String?
  preorderPriceCurrency  String?                       @db.VarChar(3)
  preorderPriceAmount    Decimal?                      @db.Decimal(18, 4)
  preorderExchangeRate   Decimal?                      @db.Decimal(18, 6)
  preorderMarkupPercent  Decimal?                      @db.Decimal(5, 2)
  preorderRateSource     String?
  preorderRateFetchedAt  DateTime?
  marketplacePriority    Int                           @default(0)
  rating                 Float                         @default(0)
  reviewCount            Int                           @default(0)
  soldCount              Int                           @default(0)
  isActive               Boolean                       @default(true)
  reviewStatus           VendorContentReviewStatus     @default(APPROVED)
  reviewedAt             DateTime?
  categoryId             String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  deletedAt              DateTime?
  businessCategoryId     String?
  discounts              Discount[]
  inventoryLogs          InventoryLedger[]
  orderItems             OrderItem[]
  reviews                ProductReview[]
  businessCategory       BusinessCategory?             @relation(fields: [businessCategoryId], references: [id])
  category               Category?                     @relation(fields: [categoryId], references: [id])
  organization           Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  masterProduct          MasterProduct?                @relation(fields: [masterProductId], references: [id], onDelete: SetNull)
  managedByWarehouse     Warehouse?                    @relation("WarehouseManagedProducts", fields: [managedByWarehouseId], references: [id], onDelete: SetNull)
  images                 ProductImage[]
  supplierDocument       ProductSupplierDocument?
  productRequests        ProductRequest[]
  warehouseInventories   WarehouseInventory[]
  stockRequestItems      WarehouseStockRequestItem[]   @relation("StockRequestProducts")
  posSaleLines           PosSaleLine[]
  posGoodsReceiptItems   PosGoodsReceiptItem[]
  cafeDailyStocks        CafeDailyStock[]
  cafeDailyStockReceipts CafeDailyStockReceipt[]
  returnItems            DispatchReturnItem[]          @relation("ReturnProducts")
  productInteractions    ProductInteraction[]
  productInterestScores  ProductInterestScore[]
  restaurantTicketItems  RestaurantTicketItem[]
  kitchenTicketItems     KitchenTicketItem[]
  reels                  Reel[]
  manualDispatchItems    WarehouseManualDispatchItem[]
  warehouseReceiptItems  WarehouseGoodsReceiptItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([masterProductId])
  @@index([managedByWarehouseId])
  @@index([reviewStatus])
  @@index([submittedById])
  @@index([categoryId])
  @@index([businessCategoryId])
  @@index([deletedAt])
  @@index([marketplacePriority])
  @@index([name])
  @@index([barcode])
  @@index([barcodeAliases], type: Gin)
  @@index([supplyType])
  @@index([organizationId, isRestaurantMenuItem, isActive])
}

model MasterProduct {
  id              String               @id @default(uuid())
  canonicalName   String
  normalizedName  String
  barcode         String?              @unique
  brand           String?
  unit            String?
  description     String?
  imageUrl        String?
  categoryName    String?
  sourceProductId String?
  status          String               @default("ACTIVE")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  products        Product[]
  aliases         MasterProductAlias[]

  @@index([normalizedName])
  @@index([status])
}

model MasterProductAlias {
  id              String        @id @default(uuid())
  masterProductId String
  value           String
  normalizedValue String
  createdAt       DateTime      @default(now())
  masterProduct   MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Cascade)

  @@unique([masterProductId, normalizedValue])
  @@index([normalizedValue])
}

enum ProductInteractionType {
  VIEW
  SEARCH
  CATEGORY_VIEW
  ADD_TO_CART
  WISHLIST
  SHARE
  RECOMMENDATION_CLICK
  PURCHASE
}

enum ReelStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum ReelVisibility {
  PUBLIC
  ORGANIZATION
  UNLISTED
  PRIVATE
}

enum ReelAssetKind {
  ORIGINAL
  MP4_720P
  MP4_480P
  THUMBNAIL
  HLS_PLAYLIST
  HLS_SEGMENT
  CAPTION_TRACK
}

enum ReelProcessingStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReelInteractionType {
  VIEW
  LIKE
  SAVE
  SHARE
  COMMENT
  FOLLOW_CLICK
  PRODUCT_CLICK
}

model Reel {
  id                 String                    @id @default(uuid())
  organizationId     String?
  authorId           String?
  reviewedById       String?
  businessCategoryId String?
  productId          String?
  title              String?
  caption            String?
  description        String?
  videoUrl           String
  thumbnailUrl       String?
  storageBucket      String?
  storagePath        String?
  hlsUrl             String?
  durationSeconds    Int?
  width              Int?
  height             Int?
  fileSizeBytes      BigInt?
  mimeType           String?
  status             ReelStatus                @default(DRAFT)
  visibility         ReelVisibility            @default(PUBLIC)
  reviewStatus       VendorContentReviewStatus @default(PENDING)
  reviewedAt         DateTime?
  publishedAt        DateTime?
  failedReason       String?
  viewCount          Int                       @default(0)
  likeCount          Int                       @default(0)
  saveCount          Int                       @default(0)
  shareCount         Int                       @default(0)
  commentCount       Int                       @default(0)
  tags               String[]                  @default([])
  metadata           Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?
  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  author             User?                     @relation("ReelAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedBy         User?                     @relation("ReelReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  businessCategory   BusinessCategory?         @relation(fields: [businessCategoryId], references: [id], onDelete: SetNull)
  product            Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  assets             ReelAsset[]
  processingJobs     ReelProcessingJob[]
  interactions       ReelInteraction[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status, publishedAt])
  @@index([authorId, createdAt])
  @@index([businessCategoryId, publishedAt])
  @@index([productId])
  @@index([status, visibility, publishedAt])
  @@index([reviewStatus])
  @@index([deletedAt])
}

model ReelAsset {
  id              String        @id @default(uuid())
  reelId          String
  kind            ReelAssetKind
  url             String
  storageBucket   String?
  storagePath     String?
  mimeType        String?
  width           Int?
  height          Int?
  durationSeconds Int?
  fileSizeBytes   BigInt?
  createdAt       DateTime      @default(now())
  reel            Reel          @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId])
  @@index([kind])
  @@index([storageBucket, storagePath])
}

model ReelProcessingJob {
  id           String               @id @default(uuid())
  reelId       String
  status       ReelProcessingStatus @default(QUEUED)
  queueName    String?
  provider     String?
  attempt      Int                  @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  reel         Reel                 @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId, createdAt])
  @@index([status, createdAt])
  @@index([provider])
}

model ReelInteraction {
  id             String              @id @default(uuid())
  reelId         String
  userId         String?
  visitorId      String?
  organizationId String?
  type           ReelInteractionType
  watchSeconds   Int?
  watchPercent   Float?
  source         String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  reel           Reel                @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([reelId, createdAt])
  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([type, createdAt])
}

model ProductInteraction {
  id                 String                 @id @default(uuid())
  userId             String?
  visitorId          String?
  productId          String?
  businessCategoryId String?
  organizationId     String?
  type               ProductInteractionType
  searchQuery        String?
  weight             Float                  @default(1)
  source             String?
  metadata           Json?
  createdAt          DateTime               @default(now())
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  product            Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  businessCategory   BusinessCategory?      @relation(fields: [businessCategoryId], references: [id], onDelete: SetNull)
  organization       Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
  @@index([productId, createdAt])
  @@index([businessCategoryId, createdAt])
  @@index([organizationId, createdAt])
  @@index([type, createdAt])
}

model ProductInterestScore {
  id                 String            @id @default(uuid())
  userId             String?
  visitorId          String?
  productId          String?
  businessCategoryId String?
  organizationId     String?
  keyword            String?
  score              Float             @default(0)
  lastEventAt        DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessCategory   BusinessCategory? @relation(fields: [businessCategoryId], references: [id], onDelete: Cascade)
  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], name: "user_product_interest")
  @@unique([visitorId, productId], name: "visitor_product_interest")
  @@unique([userId, businessCategoryId], name: "user_category_interest")
  @@unique([visitorId, businessCategoryId], name: "visitor_category_interest")
  @@unique([userId, organizationId], name: "user_organization_interest")
  @@unique([visitorId, organizationId], name: "visitor_organization_interest")
  @@unique([userId, keyword], name: "user_keyword_interest")
  @@unique([visitorId, keyword], name: "visitor_keyword_interest")
  @@index([userId, score])
  @@index([visitorId, score])
  @@index([lastEventAt])
}

model ProductRequest {
  id             String                @id @default(uuid())
  type           ProductRequestType    @default(CREATE)
  organizationId String
  submittedById  String
  reviewedById   String?
  productId      String?
  status         ProductApprovalStatus @default(PENDING)
  name           String
  description    String?
  sku            String?
  price          Decimal               @db.Decimal(18, 2)
  costPrice      Decimal?              @db.Decimal(18, 2)
  stock          Int                   @default(0)
  categoryId     String?
  rejectReason   String?
  reviewNote     String?
  submittedAt    DateTime              @default(now())
  reviewedAt     DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  category       Category?             @relation(fields: [categoryId], references: [id])
  organization   Organization          @relation(fields: [organizationId], references: [id])
  product        Product?              @relation(fields: [productId], references: [id])
  reviewedBy     User?                 @relation("ReviewedProductRequests", fields: [reviewedById], references: [id])
  submittedBy    User                  @relation("SubmittedProductRequests", fields: [submittedById], references: [id])
  images         ProductRequestImage[]

  @@index([organizationId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([status])
  @@index([productId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([organizationId, sku])
}

model ProductRequestImage {
  id               String         @id @default(uuid())
  productRequestId String
  url              String
  productRequest   ProductRequest @relation(fields: [productRequestId], references: [id], onDelete: Cascade)

  @@index([productRequestId])
}

model ProductImage {
  visualSearchEmbedding VisualSearchEmbedding?
  id        String  @id @default(uuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
}

/// Derived search data survives deploys. A lease coordinates API replicas.
model VisualSearchEmbedding {
  imageId          String @id
  productId        String
  sourceHash       String
  embeddingVersion String
  contentHash      String?
  vector           Json?
  indexedAt        DateTime?
  leaseToken       String?
  leaseUntil       DateTime?
  retryAt          DateTime?
  attempts         Int @default(0)
  updatedAt        DateTime @default(now()) @updatedAt
  image            ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([embeddingVersion, updatedAt])
}

model ProductSupplierDocument {
  id            String   @id @default(uuid())
  productId     String   @unique
  frontImageUrl String
  backImageUrl  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Discount {
  id         String    @id @default(uuid())
  productId  String
  percent    Int
  validUntil DateTime
  createdAt  DateTime  @default(now())
  isActive   Boolean   @default(true)
  updatedAt  DateTime  @updatedAt
  validFrom  DateTime?
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([validUntil])
}

/// Durable before-images and evidence for reversible inventory incident repairs.
/// Keep this mapped table in the schema so schema synchronization preserves it.
model InventoryIsolationBackup {
  runId     String   @db.Text
  tableName String   @db.Text
  recordId  String   @db.Text
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([runId, tableName, recordId], map: "_InventoryIsolationBackup_pkey")
  @@map("_InventoryIsolationBackup")
}

model InventoryLedger {
  id            String          @id @default(uuid())
  productId     String
  warehouseId   String?
  change        Int
  reason        InventoryReason
  note          String?
  createdAt     DateTime        @default(now())
  createdById   String?
  referenceId   String?
  referenceType String?
  createdBy     User?           @relation("InventoryLedgerCreatedBy", fields: [createdById], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  warehouse     Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([warehouseId, createdAt])
  @@index([reason])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([createdAt])
}

model Order {
  id                 String                 @id @default(uuid())
  organizationId     String
  customerId         String
  status             OrderStatus            @default(PENDING)
  paymentStatus      PaymentStatus          @default(PENDING)
  paymentMethod      PaymentMethod?
  shippingAddress    String
  phone              String
  note               String?
  shippingAddressId  String?
  branchId           String?
  customerLat        Float?
  customerLng        Float?
  deliveryCode       String?
  subtotal           Decimal                @db.Decimal(18, 2)
  discountAmount     Decimal                @default(0) @db.Decimal(18, 2)
  deliveryFee        Decimal                @default(0) @db.Decimal(18, 2)
  total              Decimal                @db.Decimal(18, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  orderNumber        String                 @unique
  delivery           Delivery?
  branch             Branch?                @relation("OrderAssignedBranch", fields: [branchId], references: [id])
  customer           User                   @relation("CustomerOrders", fields: [customerId], references: [id])
  organization       Organization           @relation(fields: [organizationId], references: [id])
  shippingAddressRef Address?               @relation("OrderShippingAddressRef", fields: [shippingAddressId], references: [id])
  history            OrderHistory[]
  dispatchAttempts   OrderDispatchAttempt[]
  items              OrderItem[]
  reviews            ProductReview[]
  payments           PaymentAttempt[]
  returnRequest      ReturnRequest?

  @@index([organizationId, status])
  @@index([customerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([shippingAddressId])
  @@index([branchId])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderDispatchAttempt {
  id             String                     @id @default(uuid())
  orderId        String
  branchId       String
  organizationId String
  status         OrderDispatchAttemptStatus @default(PENDING)
  sequence       Int
  distanceKm     Float?
  requestedAt    DateTime                   @default(now())
  respondedAt    DateTime?
  respondedById  String?
  expiresAt      DateTime?
  note           String?
  branch         Branch                     @relation(fields: [branchId], references: [id])
  order          Order                      @relation(fields: [orderId], references: [id])
  respondedBy    User?                      @relation("OrderDispatchAttemptRespondedBy", fields: [respondedById], references: [id])

  @@unique([orderId, branchId])
  @@index([orderId, status])
  @@index([branchId, status])
  @@index([organizationId, status])
  @@index([requestedAt])
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  price       Decimal        @db.Decimal(18, 2)
  subtotal    Decimal        @db.Decimal(18, 2)
  productName String
  productSku  String?
  order       Order          @relation(fields: [orderId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  review      ProductReview?

  @@index([orderId])
  @@index([productId])
}

model ProductReview {
  id             String       @id @default(uuid())
  orderId        String
  orderItemId    String       @unique
  productId      String
  organizationId String
  customerId     String
  score          Int
  comment        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       User         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([score])
}

model OrderHistory {
  id          String       @id @default(uuid())
  orderId     String
  timestamp   DateTime     @default(now())
  changedById String?
  note        String?
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedBy   User?        @relation("OrderHistoryChangedBy", fields: [changedById], references: [id])
  order       Order        @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([timestamp])
  @@index([changedById])
}

model PaymentAttempt {
  id            String        @id @default(uuid())
  orderId       String
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(18, 2)
  providerRef   String?
  rawPayload    Json?
  failureReason String?
  paidAt        DateTime?
  refundedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
}

model Delivery {
  id                      String               @id @default(uuid())
  orderId                 String?              @unique
  stockDispatchId         String?              @unique
  sourceType              DeliverySourceType   @default(WEBSITE_ORDER)
  requesterOrganizationId String?
  providerOrganizationId  String?
  partnershipId           String?
  warehouseId             String?
  courierId               String?
  status                  DeliveryStatus       @default(WAITING)
  trackingCode            String?
  packageCount            Int                  @default(1)
  totalWeightKg           Decimal?             @db.Decimal(10, 2)
  packageLengthCm         Decimal?             @db.Decimal(10, 2)
  packageWidthCm          Decimal?             @db.Decimal(10, 2)
  packageHeightCm         Decimal?             @db.Decimal(10, 2)
  sizeCategory            String?
  isFragile               Boolean              @default(false)
  handlingInstructions    String?
  readyAt                 DateTime?
  pickupTime              DateTime?
  deliveredAt             DateTime?
  proofImage              String?
  updatedAt               DateTime             @updatedAt
  cancelledAt             DateTime?
  createdAt               DateTime             @default(now())
  courier                 User?                @relation("CourierDeliveries", fields: [courierId], references: [id])
  order                   Order?               @relation(fields: [orderId], references: [id])
  stockDispatch           StockDispatch?       @relation(fields: [stockDispatchId], references: [id])
  requesterOrganization   Organization?        @relation("DeliveryRequesterOrganization", fields: [requesterOrganizationId], references: [id], onDelete: SetNull)
  providerOrganization    Organization?        @relation("DeliveryProviderOrganization", fields: [providerOrganizationId], references: [id], onDelete: SetNull)
  partnership             DeliveryPartnership? @relation(fields: [partnershipId], references: [id], onDelete: SetNull)
  warehouse               Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([courierId])
  @@index([providerOrganizationId, status])
  @@index([requesterOrganizationId, status])
  @@index([partnershipId])
  @@index([warehouseId, status])
  @@index([sourceType, status])
  @@index([status])
  @@index([createdAt])
}

model DeliveryPartnership {
  id                      String                       @id @default(uuid())
  requesterOrganizationId String?
  providerOrganizationId  String
  warehouseId             String?
  status                  DeliveryPartnershipStatus    @default(PENDING)
  message                 String?
  rejectionReason         String?
  requestedById           String
  respondedById           String?
  respondedAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  requesterOrganization   Organization?                @relation("DeliveryPartnershipRequester", fields: [requesterOrganizationId], references: [id], onDelete: Cascade)
  providerOrganization    Organization                 @relation("DeliveryPartnershipProvider", fields: [providerOrganizationId], references: [id], onDelete: Cascade)
  warehouse               Warehouse?                   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  requestedBy             User                         @relation("DeliveryPartnershipRequestedBy", fields: [requestedById], references: [id])
  respondedBy             User?                        @relation("DeliveryPartnershipRespondedBy", fields: [respondedById], references: [id])
  courierAssignments      WarehouseCourierAssignment[]
  deliveries              Delivery[]

  @@index([requesterOrganizationId, status])
  @@index([providerOrganizationId, status])
  @@index([warehouseId, status])
  @@index([createdAt])
}

model WarehouseCourierAssignment {
  id                     String              @id @default(uuid())
  warehouseId            String
  providerOrganizationId String
  partnershipId          String
  courierId              String
  assignedById           String
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  warehouse              Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  providerOrganization   Organization        @relation("CourierProviderOrganization", fields: [providerOrganizationId], references: [id], onDelete: Cascade)
  partnership            DeliveryPartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  courier                User                @relation("WarehouseAssignedCourier", fields: [courierId], references: [id], onDelete: Cascade)
  assignedBy             User                @relation("WarehouseCourierAssignedBy", fields: [assignedById], references: [id])

  @@unique([warehouseId, courierId])
  @@index([providerOrganizationId, isActive])
  @@index([partnershipId, isActive])
  @@index([courierId, isActive])
}

model CourierLocationHistory {
  id        String   @id @default(uuid())
  userId    String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  user      User     @relation("CourierLocationHistoryUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String       @unique
  reason       String
  status       ReturnStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id])
  resolvedBy   User?        @relation("ReturnRequestResolvedBy", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([resolvedById])
  @@index([createdAt])
}

model ServiceRequest {
  id             String               @id @default(uuid())
  organizationId String
  servicePostId  String?
  requestedById  String
  type           ServiceRequestType
  title          String
  description    String?
  status         ServiceRequestStatus @default(PENDING)
  adminNote      String?
  assignedToId   String?
  estimatedPrice Decimal?             @db.Decimal(18, 2)
  finalPrice     Decimal?             @db.Decimal(18, 2)
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  assignedTo     User?                @relation("ServiceRequestAssignedTo", fields: [assignedToId], references: [id])
  organization   Organization         @relation(fields: [organizationId], references: [id])
  requestedBy    User                 @relation("ServiceRequestRequestedBy", fields: [requestedById], references: [id])
  servicePost    ServicePost?         @relation(fields: [servicePostId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([servicePostId])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum WarehouseType {
  CENTRAL
  VENDOR_INTERNAL
}

model Warehouse {
  investmentTopUps WarehouseInvestmentTopUp[]
  investorDividends WarehouseInvestorDividend[]
  investments WarehouseInvestment[]

  viewers WarehouseViewer[]
  retailOrders WarehouseRetailOrder[]
  outgoingTransfers WarehouseTransfer[] @relation("TransferSource")
  incomingTransfers WarehouseTransfer[] @relation("TransferDestination")
  catalogOrganizationId String? @unique
  catalogOrganization Organization? @relation("WarehouseCatalogOwner", fields: [catalogOrganizationId], references: [id], onDelete: Restrict)
  stocktakes Stocktake[]

  id                   String                       @id @default(uuid())
  name                 String
  address              String
  capacity             Int                          @default(0)
  lat                  Float?
  lng                  Float?
  createdById          String?
  isActive             Boolean                      @default(true)
  type                 WarehouseType                @default(CENTRAL)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  deletedAt            DateTime?
  city                 String                       @default("")
  district             String                       @default("")
  phone                String?
  paymentAccountId     String?
  dispatches           StockDispatch[]              @relation("WarehouseDispatches")
  createdBy            User?                        @relation("WarehouseCreatedBy", fields: [createdById], references: [id])
  inventories          WarehouseInventory[]
  managedProducts      Product[]                    @relation("WarehouseManagedProducts")
  organizations        WarehouseOrganization[]
  setupTokens          WarehouseSetupToken[]        @relation("WarehouseSetupTokens")
  stockRequests        WarehouseStockRequest[]      @relation("WarehouseStockRequests")
  dispatchReturns      DispatchReturn[]             @relation("WarehouseReturns")
  deliveryPartnerships DeliveryPartnership[]
  courierAssignments   WarehouseCourierAssignment[]
  deliveries           Delivery[]
  manualDispatches     WarehouseManualDispatch[]
  goodsReceipts        WarehouseGoodsReceipt[]
  inventoryLedger      InventoryLedger[]

  @@index([createdById])
  @@index([isActive])
  @@index([type])
  @@index([deletedAt])
}

model WarehouseOrganization {
  id             String       @id @default(uuid())
  warehouseId    String
  organizationId String
  assignedAt     DateTime     @default(now())
  assignedById   String?
  assignedBy     User?        @relation("WarehouseAssignedBy", fields: [assignedById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, organizationId])
  @@index([warehouseId])
  @@index([organizationId])
}

model WarehouseInventory {
  id              String    @id @default(uuid())
  warehouseId     String
  productId       String
  quantity        Int       @default(0)
  minQuantity     Int       @default(0)
  maxQuantity     Int?
  location        String?
  batchNumber     String?
  expiryDate      DateTime?
  lastRestockedAt DateTime?
  lastAuditedAt   DateTime?
  note            String?
  showOnWeb       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@index([quantity])
  @@index([showOnWeb])
}

enum WarehouseGoodsReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model WarehouseGoodsReceipt {
  id                     String                            @id @default(uuid())
  receiptNumber          String                            @unique
  warehouseId            String
  supplierName           String
  supplierRegisterNumber String?
  supplierDocumentNumber String?
  documentDate           DateTime?                         @db.Date
  status                 WarehouseGoodsReceiptStatus       @default(DRAFT)
  note                   String?
  createdById            String
  confirmedById          String?
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt
  warehouse              Warehouse                         @relation(fields: [warehouseId], references: [id])
  createdBy              User                              @relation("WarehouseGoodsReceiptCreatedBy", fields: [createdById], references: [id])
  confirmedBy            User?                             @relation("WarehouseGoodsReceiptConfirmedBy", fields: [confirmedById], references: [id])
  items                  WarehouseGoodsReceiptItem[]
  attachments            WarehouseGoodsReceiptAttachment[]

  @@unique([warehouseId, supplierDocumentNumber])
  @@index([warehouseId, status, createdAt])
  @@index([supplierName])
  @@index([createdById])
  @@index([confirmedById])
}

model WarehouseGoodsReceiptItem {
  id          String                @id @default(uuid())
  receiptId   String
  productId   String
  quantity    Int
  unitCost    Decimal               @db.Decimal(18, 2)
  batchNumber String?
  expiryDate  DateTime?             @db.Date
  location    String?
  note        String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  receipt     WarehouseGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
  @@index([batchNumber])
  @@index([expiryDate])
}

model WarehouseGoodsReceiptAttachment {
  id        String                @id @default(uuid())
  receiptId String
  name      String
  mimeType  String
  url       String
  createdAt DateTime              @default(now())
  receipt   WarehouseGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

/// A transactional, operator-created dispatch to an arbitrary destination.
/// Unlike StockDispatch this does not require a vendor stock request.
model WarehouseManualDispatch {
  id             String                        @id @default(uuid())
  dispatchNumber String                        @unique
  warehouseId    String
  recipientName  String?
  recipientPhone String?
  address        String
  lat            Float
  lng            Float
  reason         String?
  note           String?
  createdById    String
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  warehouse      Warehouse                     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy      User                          @relation("WarehouseManualDispatchCreatedBy", fields: [createdById], references: [id])
  items          WarehouseManualDispatchItem[]

  @@index([warehouseId, createdAt])
  @@index([createdById])
  @@index([address])
}

model WarehouseManualDispatchItem {
  id         String                  @id @default(uuid())
  dispatchId String
  productId  String
  quantity   Int
  dispatch   WarehouseManualDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
  @@index([productId])
}

model WarehouseStockRequest {
  id              String                      @id @default(uuid())
  requestNumber   String                      @unique
  organizationId  String
  warehouseId     String
  status          StockRequestStatus          @default(PENDING)
  note            String?
  deliveryAddress String?
  deliveryPhone   String?
  requestedById   String
  reviewedById    String?
  reviewNote      String?
  reviewedAt      DateTime?
  requestedAt     DateTime                    @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  dispatch        StockDispatch?
  payment         StockRequestPayment?
  organization    Organization                @relation("OrganizationStockRequests", fields: [organizationId], references: [id])
  requestedBy     User                        @relation("StockRequestsRequested", fields: [requestedById], references: [id])
  reviewedBy      User?                       @relation("StockRequestsReviewed", fields: [reviewedById], references: [id])
  warehouse       Warehouse                   @relation("WarehouseStockRequests", fields: [warehouseId], references: [id])
  items           WarehouseStockRequestItem[]

  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([requestedAt])
}

model WarehouseStockRequestItem {
  id               String                @id @default(uuid())
  requestId        String
  productId        String
  quantity         Int
  approvedQuantity Int?
  note             String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  product          Product               @relation("StockRequestProducts", fields: [productId], references: [id])
  request          WarehouseStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId])
  @@index([requestId])
  @@index([productId])
}

model StockRequestPayment {
  costAmount Decimal? @db.Decimal(18, 2)
  id             String                     @id @default(uuid())
  invoiceNumber  String                     @unique
  requestId      String                     @unique
  organizationId String
  totalAmount    Decimal                    @db.Decimal(18, 2)
  paidAmount     Decimal                    @default(0) @db.Decimal(18, 2)
  status         PaymentStatus              @default(PENDING)
  paymentMethod  PaymentMethod?
  paidAt         DateTime?
  paidBy         String?
  transactionId  String?
  note           String?
  confirmedById  String?
  confirmedAt    DateTime?
  dueDate        DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  confirmedBy    User?                      @relation("PaymentConfirmations", fields: [confirmedById], references: [id])
  organization   Organization               @relation("OrganizationStockPayments", fields: [organizationId], references: [id])
  request        WarehouseStockRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  entries        StockRequestPaymentEntry[]

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

/// Immutable payment ledger. A stock invoice may be settled through multiple
/// cash/QPay entries while StockRequestPayment keeps the aggregate balance.
model StockRequestPaymentEntry {
  receipt       StockPaymentReceipt?
  id            String               @id @default(uuid())
  paymentId     String
  amount        Decimal              @db.Decimal(18, 2)
  method        PaymentMethod
  status        PaymentStatus        @default(PENDING)
  transactionId String?              @unique
  confirmedById String?
  confirmedAt   DateTime?
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  payment       StockRequestPayment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  confirmedBy   User?                @relation("StockPaymentEntryConfirmations", fields: [confirmedById], references: [id])

  @@index([paymentId, status])
  @@index([createdAt])
}

model StockPaymentReceipt {
  id        String                   @id @default(uuid())
  entryId   String                   @unique
  name      String
  mimeType  String
  content   Bytes
  createdAt DateTime                 @default(now())
  entry     StockRequestPaymentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

/// Dispatch order created when admin approves a stock request.
/// Warehouse operator sees this and confirms dispatch → inventory deducted.
model StockDispatch {
  id             String                @id @default(uuid())
  dispatchNumber String                @unique
  requestId      String                @unique
  warehouseId    String
  organizationId String
  status         DispatchStatus        @default(PENDING)
  driverId       String?
  driverName     String?
  driverPhone    String?
  vehicleNumber  String?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  note           String?
  padaanUrl      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  driver         User?                 @relation("DriverDispatches", fields: [driverId], references: [id])
  organization   Organization          @relation("OrganizationDispatches", fields: [organizationId], references: [id])
  request        WarehouseStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  warehouse      Warehouse             @relation("WarehouseDispatches", fields: [warehouseId], references: [id])
  returns        DispatchReturn[]
  delivery       Delivery?

  @@index([warehouseId])
  @@index([organizationId])
  @@index([status])
  @@index([driverId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Dispatch Returns — goods returned after delivery
// ─────────────────────────────────────────────────────────────────────────

/// Return request for defective/wrong goods from a delivered dispatch.
/// Warehouse admin manually approves; approved returns restore inventory.
model DispatchReturn {
  id             String               @id @default(uuid())
  returnNumber   String               @unique
  dispatchId     String
  warehouseId    String
  organizationId String
  status         ReturnStatus         @default(PENDING)
  reason         String?
  note           String?
  rejectReason   String?
  requestedAt    DateTime             @default(now())
  approvedAt     DateTime?
  rejectedAt     DateTime?
  approvedById   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  dispatch       StockDispatch        @relation(fields: [dispatchId], references: [id])
  warehouse      Warehouse            @relation("WarehouseReturns", fields: [warehouseId], references: [id])
  organization   Organization         @relation("OrganizationReturns", fields: [organizationId], references: [id])
  approvedBy     User?                @relation("ReturnApprovals", fields: [approvedById], references: [id])
  items          DispatchReturnItem[]

  @@index([dispatchId])
  @@index([warehouseId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model DispatchReturnItem {
  id        String         @id @default(uuid())
  returnId  String
  productId String
  quantity  Int
  reason    String?
  return    DispatchReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product   Product        @relation("ReturnProducts", fields: [productId], references: [id])

  @@unique([returnId, productId])
  @@index([returnId])
  @@index([productId])
}

model CardPaymentAttempt {
  id              String           @id @default(uuid())
  registerId      String?
  organizationId  String?
  terminalId      String
  bridgeUrl       String?
  amount          Decimal          @db.Decimal(18, 2)
  status          PosPaymentStatus @default(PENDING)
  transactionId   String?
  traceno         String?
  message         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  consumedAt      DateTime?
  initiatedById   String?
  providerPayload Json?
  saleReference   String?
  initiatedBy     User?            @relation("CardPaymentAttemptInitiatedBy", fields: [initiatedById], references: [id])
  register        PosRegister?     @relation(fields: [registerId], references: [id])

  @@index([registerId])
  @@index([status])
  @@index([createdAt])
  @@index([initiatedById])
  @@index([saleReference])
}

model QPayInvoice {
  id             String        @id @default(uuid())
  registerId     String?
  organizationId String?
  amount         Decimal       @db.Decimal(18, 2)
  qrText         String
  status         PosQPayStatus @default(PENDING)
  expiresAt      DateTime
  paidAt         DateTime?
  webhookPayload Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  consumedAt     DateTime?
  initiatedById  String?
  paymentId      String?       @unique
  saleReference  String?
  initiatedBy    User?         @relation("QPayInvoiceInitiatedBy", fields: [initiatedById], references: [id])
  register       PosRegister?  @relation(fields: [registerId], references: [id])

  @@index([registerId])
  @@index([status])
  @@index([expiresAt])
  @@index([initiatedById])
  @@index([saleReference])
}

model PaidAccessPurchase {
  id          String               @id @default(uuid())
  userId      String
  sourceType  PaidAccessSourceType
  itemId      String
  title       String
  fileUrl     String?
  fileName    String?
  amount      Int                  @default(0)
  invoiceId   String?              @unique
  metadata    Json?
  purchasedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, itemId])
  @@index([userId, purchasedAt])
  @@index([sourceType, itemId])
}

model MPointLedger {
  id                    String                 @id @default(uuid())
  userId                String
  type                  MPointLedgerType
  amount                Int
  balanceAfter          Int?
  sourceType            PaidAccessSourceType?
  sourceId              String?
  invoiceId             String?                @unique
  description           String
  createdAt             DateTime               @default(now())
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posLoyaltyTransaction PosLoyaltyTransaction?

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model PosSaleIdempotency {
  id             String   @id @default(uuid())
  clientSaleId   String
  receiptNo      String   @unique
  organizationId String
  registerId     String?
  response       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, clientSaleId])
  @@index([organizationId])
  @@index([registerId])
  @@index([createdAt])
}

model Post {
  id             String                    @id @default(uuid())
  authorId       String
  organizationId String?
  submittedById  String?
  reviewedById   String?
  type           PostType                  @default(GENERAL)
  content        String
  imageUrls      String[]                  @default([])
  tags           String[]                  @default([])
  viewCount      Int                       @default(0)
  likeCount      Int                       @default(0)
  commentCount   Int                       @default(0)
  isPinned       Boolean                   @default(false)
  isOfficial     Boolean                   @default(false)
  reviewStatus   VendorContentReviewStatus @default(APPROVED)
  reviewedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  author         User                      @relation("PostAuthor", fields: [authorId], references: [id])
  organization   Organization?             @relation("OrganizationPosts", fields: [organizationId], references: [id])
  comments       PostComment[]
  likes          PostLike[]

  @@index([authorId])
  @@index([organizationId])
  @@index([reviewStatus])
  @@index([submittedById])
  @@index([type])
  @@index([isPinned])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

model Form {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  description String?
  fields      Json
  isActive    Boolean        @default(true)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User?          @relation("FormCreatedBy", fields: [createdById], references: [id])
  responses   FormResponse[]

  @@index([slug])
  @@index([isActive])
  @@index([createdById])
  @@index([createdAt])
}

model FormResponse {
  id          String   @id @default(uuid())
  formId      String
  data        Json
  submittedAt DateTime @default(now())
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([submittedAt])
}

model AttendanceZone {
  id             String             @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  lat            Float
  lng            Float
  radiusMeters   Int                @default(500)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  records        AttendanceRecord[]
  branch         Branch?            @relation(fields: [branchId], references: [id])
  organization   Organization       @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([isActive])
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  zoneId         String?
  clockIn        DateTime
  clockInLat     Float?
  clockInLng     Float?
  clockInMethod  AttendanceAuth
  clockOut       DateTime?
  clockOutLat    Float?
  clockOutLng    Float?
  clockOutMethod AttendanceAuth?
  totalMinutes   Int?
  note           String?
  status         AttendanceStatus @default(PRESENT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation("OrgAttendanceRecords", fields: [organizationId], references: [id])
  user           User             @relation("AttendanceRecordUser", fields: [userId], references: [id])
  zone           AttendanceZone?  @relation(fields: [zoneId], references: [id])

  @@index([userId, clockIn])
  @@index([organizationId, clockIn])
  @@index([zoneId])
}

model ChatSession {
  id          String            @id @default(cuid())
  visitorId   String
  userId      String?
  displayName String?
  status      ChatSessionStatus @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  messages    ChatMessage[]
  user        User?             @relation("UserChatSessions", fields: [userId], references: [id])

  @@index([visitorId])
  @@index([userId])
  @@index([status, updatedAt])
}

model ChatMessage {
  id        String            @id @default(cuid())
  sessionId String
  sender    ChatMessageSender
  senderId  String?
  text      String
  createdAt DateTime          @default(now())
  session   ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

