// ─────────────────────────────────────────────────────────────────────────
// Direct Messaging (Messenger-like peer-to-peer chat)
// ─────────────────────────────────────────────────────────────────────────
enum ChatApp {
  BUSINESS
  STORE
}

model Conversation {
  app ChatApp @default(BUSINESS)
  id           String                    @id @default(cuid())
  type         ConversationType          @default(DIRECT)
  name         String?
  avatarUrl    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([updatedAt])
  @@index([app, updatedAt])
}

model ConversationParticipant {
  id             String                        @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationParticipantRole   @default(MEMBER)
  status         ConversationParticipantStatus @default(ACCEPTED)
  lastReadAt     DateTime?
  joinedAt       DateTime                      @default(now())
  conversation   Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                          @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           DmType       @default(TEXT)
  content        String
  fileName       String?
  fileSize       Int?
  duration       Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model PushToken {
  app ChatApp @default(BUSINESS)
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationParticipantRole {
  ADMIN
  MEMBER
}

enum ConversationParticipantStatus {
  ACCEPTED
  PENDING
  DECLINED
}

enum DmType {
  TEXT
  VOICE
  IMAGE
  FILE
}

// ─────────────────────────────────────────────────────────────────────────
// POS Shift & Structured Sales
// ─────────────────────────────────────────────────────────────────────────

/// Cashier shift — tracks opening/closing cash and links sales.
model RestaurantTable {
  id             String             @id @default(uuid())
  organizationId String
  branchId       String
  code           String
  label          String
  qrToken        String?            @unique
  zone           String             @default("Гол заал")
  seats          Int                @default(4)
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets        RestaurantTicket[]

  @@unique([branchId, code])
  @@index([organizationId])
  @@index([branchId, isActive])
  @@index([branchId, sortOrder])
  @@index([qrToken])
}

model RestaurantMenuCategory {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, sortOrder])
}

model RestaurantDiscountSchedule {
  id             String       @id @default(uuid())
  organizationId String       @unique
  isEnabled      Boolean      @default(false)
  percent        Int          @default(20)
  startMinute    Int          @default(540)
  endMinute      Int          @default(1020)
  timeZone       String       @default("Asia/Ulaanbaatar")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isEnabled])
}

/// Coffee-shop daily preparation/intake sheet. Sales are calculated from
/// completed POS sale lines and are intentionally not duplicated here.
model CafeDailyStock {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  productId      String
  businessDate   DateTime     @db.Date
  openingQty     Decimal      @default(0) @db.Decimal(18, 3)
  wasteQty       Decimal      @default(0) @db.Decimal(18, 3)
