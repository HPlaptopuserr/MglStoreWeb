/// Immutable receipt lines for products prepared or received during a cafe
/// business day. Voiding keeps the audit trail while removing the quantity
/// from that day's received total.
model CafeDailyStockReceipt {
  id             String       @id @default(uuid())
  batchId        String
  organizationId String
  branchId       String
  productId      String
  businessDate   DateTime     @db.Date
  quantity       Decimal      @db.Decimal(18, 3)
  note           String?
  receivedById   String?
  voidedAt       DateTime?
  voidedById     String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
