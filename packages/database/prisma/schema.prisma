  monthlyLimit Decimal?               @db.Decimal(18, 2)
  isActive     Boolean                @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  contract     RestaurantMealContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  charges      RestaurantMealCharge[]

  @@unique([contractId, employeeCode])
  @@index([contractId, isActive])
  @@index([fullName])
}

model RestaurantMealCharge {
  id                   String                       @id @default(uuid())
  organizationId       String
  contractId           String
  memberId             String?
  branchId             String
  shiftId              String
  cashierId            String
  restaurantTicketId   String                       @unique
  clientRequestId      String?                      @unique
  companyNameSnapshot  String
  employeeCodeSnapshot String?
  employeeNameSnapshot String?
  amount               Decimal                      @db.Decimal(18, 2)
  packagingFee         Decimal                      @default(0) @db.Decimal(18, 2)
  status               RestaurantMealChargeStatus   @default(ACTIVE)
  note                 String?
  orderedAt            DateTime                     @default(now())
  voidedAt             DateTime?
  voidReason           String?
