model Contract {
  id                String             @id @default(uuid())
  version           String             @default("v1.0")
  status            ContractStatus     @default(PENDING)
  userId            String
  organizationId    String?
  feePlan           String?
  isPaid            Boolean            @default(false)
  isTemplate        Boolean            @default(false)
  templateId        String?
  pdfUrl            String?
  documentHash      String?
  otpSecret         String?
  adminSignature    String?
  adminName         String?
  adminTitle        String?
  adminStamp        String?
  qpayInvoiceId     String?
  systemQrInvoiceId String?
  paymentSystem     String?            @default("QPAY")
  memberData        Json?
  memberSignature   String?
  headerData        Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  signedAt          DateTime?
  user              User               @relation(fields: [userId], references: [id])
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  auditLogs         ContractAuditLog[]
  template          Contract?          @relation("ContractSubmissions", fields: [templateId], references: [id])
  submissions       Contract[]         @relation("ContractSubmissions")

  @@index([userId])
  @@index([organizationId])
  @@index([documentHash])
  @@index([templateId])
  @@index([isTemplate])
}

model ContractAuditLog {
  id         String   @id @default(uuid())
  contractId String
  action     String // FORM_SUBMITTED, OTP_VERIFIED, PDF_GENERATED, SIGNED
  ipAddress  String?
  userAgent  String?
