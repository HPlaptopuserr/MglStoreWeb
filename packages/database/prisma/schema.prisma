  updatedBy User @relation("WarehouseInvestmentRecorder", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([warehouseId, userId])
  @@index([userId])
}


model WarehouseInvestmentTopUp {
  id String @id @default(uuid())
  requestId String @unique
  warehouseId String
  userId String
