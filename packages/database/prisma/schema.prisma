// ─────────────────────────────────────────────────────────────────────────
// Direct Messaging (Messenger-like peer-to-peer chat)
// ─────────────────────────────────────────────────────────────────────────
model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType          @default(DIRECT)
  name         String?
  avatarUrl    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String                        @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationParticipantRole   @default(MEMBER)
  status         ConversationParticipantStatus @default(ACCEPTED)
  lastReadAt     DateTime?
  joinedAt       DateTime                      @default(now())
  conversation   Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                          @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           DmType       @default(TEXT)
  content        String
  fileName       String?
  fileSize       Int?
  duration       Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationParticipantRole {
  ADMIN
  MEMBER
}

enum ConversationParticipantStatus {
  ACCEPTED
  PENDING
  DECLINED
}

enum DmType {
  TEXT
  VOICE
  IMAGE
  FILE
}

// ─────────────────────────────────────────────────────────────────────────
// POS Shift & Structured Sales
// ─────────────────────────────────────────────────────────────────────────

/// Cashier shift — tracks opening/closing cash and links sales.
model RestaurantTable {
  id             String             @id @default(uuid())
  organizationId String
  branchId       String
  code           String
  label          String
  qrToken        String?            @unique
  zone           String             @default("Гол заал")
  seats          Int                @default(4)
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets        RestaurantTicket[]

  @@unique([branchId, code])
  @@index([organizationId])
  @@index([branchId, isActive])
  @@index([branchId, sortOrder])
  @@index([qrToken])
}

model RestaurantTicket {
  id             String                 @id @default(uuid())
  ticketNo       String                 @unique
  organizationId String
  branchId       String
  shiftId        String
  tableId        String?
  openedById     String
  posSaleId      String?                @unique
  orderMode      RestaurantOrderMode    @default(DINE_IN)
  status         RestaurantTicketStatus @default(OPEN)
  guestCount     Int                    @default(1)
  note           String?
  openedAt       DateTime               @default(now())
  sentAt         DateTime?
  closedAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift          PosShift               @relation(fields: [shiftId], references: [id])
  table          RestaurantTable?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  openedBy       User                   @relation("RestaurantTicketOpenedBy", fields: [openedById], references: [id])
  posSale        PosSale?               @relation(fields: [posSaleId], references: [id], onDelete: SetNull)
  items          RestaurantTicketItem[]
  kitchenTickets KitchenTicket[]

  @@index([organizationId, status])
  @@index([branchId, status])
  @@index([shiftId])
  @@index([tableId, status])
  @@index([openedById])
  @@index([openedAt])
}

model RestaurantTicketItem {
  id                 String              @id @default(uuid())
  ticketId           String
  productId          String
  productName        String
  unitPrice          Decimal             @db.Decimal(18, 2)
  qty                Int
  sentQty            Int                 @default(0)
  note               String?
  kitchenStation     String?
  preparationMinutes Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ticket             RestaurantTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  kitchenItems       KitchenTicketItem[]

  @@unique([ticketId, productId])
  @@index([productId])
}

model KitchenTicket {
  id                 String              @id @default(uuid())
  kitchenTicketNo    String              @unique
  organizationId     String
  branchId           String
  restaurantTicketId String
  sentById           String
  status             KitchenTicketStatus @default(NEW)
  sentAt             DateTime            @default(now())
  startedAt          DateTime?
  readyAt            DateTime?
  servedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  restaurantTicket   RestaurantTicket    @relation(fields: [restaurantTicketId], references: [id], onDelete: Cascade)
  sentBy             User                @relation("KitchenTicketSentBy", fields: [sentById], references: [id])
  items              KitchenTicketItem[]

  @@index([organizationId, status])
  @@index([branchId, status])
  @@index([restaurantTicketId])
  @@index([sentById])
  @@index([sentAt])
}

model KitchenTicketItem {
  id                     String               @id @default(uuid())
  kitchenTicketId        String
  restaurantTicketItemId String
  productId              String
  productName            String
  qty                    Int
  note                   String?
  kitchenStation         String?
  preparationMinutes     Int?
  createdAt              DateTime             @default(now())
  kitchenTicket          KitchenTicket        @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)
  restaurantTicketItem   RestaurantTicketItem @relation(fields: [restaurantTicketItemId], references: [id])
  product                Product              @relation(fields: [productId], references: [id])

  @@index([kitchenTicketId])
  @@index([restaurantTicketItemId])
  @@index([productId])
  @@index([kitchenStation])
}

enum RestaurantOrderMode {
  DINE_IN
  TO_GO
  DELIVERY
}

enum RestaurantTicketStatus {
  OPEN
  KITCHEN
  READY
  SERVED
  PAID
  CLOSED
  CANCELLED
}

enum KitchenTicketStatus {
  NEW
  PREPARING
