  @@index([contractId, orderedAt])
  @@index([memberId, orderedAt])
  @@index([branchId, orderedAt])
  @@index([shiftId])
  @@index([cashierId])
  @@index([status, orderedAt])
}

model PosShift {
  id                String             @id @default(uuid())
