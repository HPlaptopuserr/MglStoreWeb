  branchId            String
  mode                PosRegisterMode      @default(RETAIL)
  name                String
  label               String?
  cardEnabled         Boolean              @default(false)
  cardProviderType    String?
  cardTerminalId      String?
  terminalBridgeUrl   String?
  qpayEnabled         Boolean              @default(false)
  qpayMerchantId      String?
  qpayTerminalId      String?
  ebarimtEnabled      Boolean              @default(false)
  ebarimtPosApiUrl    String?
  ebarimtMerchantTin  String?
  ebarimtPosNo        String?              @unique
  ebarimtMerchantName String?
  isActive            Boolean              @default(false)
  createdAt           DateTime             @default(now())
