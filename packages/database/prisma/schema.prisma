  SERVED
  CANCELLED
}

model PosShift {
  id                String             @id @default(uuid())
  organizationId    String
  branchId          String
  registerId        String?
  cashierId         String
  status            ShiftStatus        @default(OPEN)
  openingCash       Decimal            @db.Decimal(18, 2)
  closingCash       Decimal?           @db.Decimal(18, 2)
  expectedCash      Decimal?           @db.Decimal(18, 2)
  cashDifference    Decimal?           @db.Decimal(18, 2)
  cashCount         Json?
  cashCountedAt     DateTime?
  note              String?
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  register          PosRegister?       @relation(fields: [registerId], references: [id])
  cashier           User               @relation("PosShiftCashier", fields: [cashierId], references: [id])
  sales             PosSale[]
  creditSales       PosCreditSale[]
  restaurantTickets RestaurantTicket[]

  @@index([organizationId])
  @@index([branchId])
  @@index([cashierId])
  @@index([status])
  @@index([openedAt])
}

model PosCashDrawerEvent {
  id             String              @id @default(uuid())
  organizationId String
  branchId       String
  registerId     String?
  shiftId        String
  cashierId      String
  type           CashDrawerEventType
  amount         Decimal             @db.Decimal(18, 2)
  note           String?
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([branchId])
  @@index([registerId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([type])
  @@index([createdAt])
}

/// Structured POS sale record.
model PosSale {
  id               String                 @id @default(uuid())
  receiptNo        String                 @unique
  organizationId   String
  branchId         String
  registerId       String?
  shiftId          String
  cashierId        String
  status           PosSaleStatus          @default(COMPLETED)
  paymentMethod    String
  paymentBreakdown Json?
  subtotal         Decimal                @db.Decimal(18, 2)
  taxTotal         Decimal                @db.Decimal(18, 2)
  discountTotal    Decimal                @db.Decimal(18, 2)
  grandTotal       Decimal                @db.Decimal(18, 2)
  note             String?
  ebarimtStatus    String?
  ebarimtBillId    String?
  ebarimtReceiptId String?
  ebarimtQrData    String?
  ebarimtLottery   String?
  ebarimtDate      DateTime?
  ebarimtError     String?
  ebarimtPayload   Json?
  ebarimtSyncedAt  DateTime?
  voidedAt         DateTime?
  voidReason       String?
  voidedById       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id])
  branch           Branch                 @relation(fields: [branchId], references: [id])
  register         PosRegister?           @relation(fields: [registerId], references: [id])
  shift            PosShift               @relation(fields: [shiftId], references: [id])
  cashier          User                   @relation("PosSaleCashier", fields: [cashierId], references: [id])
  lines            PosSaleLine[]
  loyalty          PosLoyaltyTransaction?
  creditSale       PosCreditSale?
  restaurantTicket RestaurantTicket?

  @@index([organizationId])
  @@index([branchId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([status])
  @@index([createdAt])
}

model PosLoyaltyTransaction {
  id              String           @id @default(uuid())
  saleId          String           @unique
  organizationId  String
  branchId        String
  userId          String?
  customerPhone   String
  action          MPointLedgerType
  baseRate        Decimal          @db.Decimal(5, 4)
  effectiveRate   Decimal          @db.Decimal(5, 4)
  saleTotal       Decimal          @db.Decimal(18, 2)
  earnedPoints    Int              @default(0)
  redeemedPoints  Int              @default(0)
  membershipBadge String?
  note            String?
  ledgerId        String?          @unique
  createdAt       DateTime         @default(now())
  sale            PosSale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  user            User?            @relation("PosLoyaltyCustomer", fields: [userId], references: [id], onDelete: SetNull)
  ledger          MPointLedger?    @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model PosLoyaltyRedemptionSession {
  id              String                     @id @default(uuid())
  token           String                     @unique
  organizationId  String
  branchId        String
  registerId      String?
  cashierId       String
  userId          String
  customerPhone   String
  requestedPoints Int
  saleTotal       Decimal                    @db.Decimal(18, 2)
  status          PosLoyaltyRedemptionStatus @default(PENDING)
  expiresAt       DateTime
  confirmedAt     DateTime?
  consumedAt      DateTime?
  cancelledAt     DateTime?
  saleId          String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([registerId, createdAt])
  @@index([cashierId, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([saleId])
}

model PosCreditCustomer {
  id                    String          @id @default(uuid())
  organizationId        String
  targetType            String
  borrowerId            String
  borrowerName          String
  borrowerPhone         String?
  borrowerEmail         String?
  borrowerAddress       String?
  employeeId            String?
  employeeName          String?
  normalizedBorrowerKey String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization    @relation(fields: [organizationId], references: [id])
  credits               PosCreditSale[]

  @@unique([organizationId, normalizedBorrowerKey])
  @@index([organizationId])
  @@index([borrowerName])
  @@index([borrowerId])
}

model PosCreditSale {
  id                  String             @id @default(uuid())
  saleId              String             @unique
  customerId          String?
  organizationId      String
  branchId            String
  registerId          String?
  shiftId             String
  cashierId           String
  targetType          String
  borrowerId          String
  borrowerName        String
  borrowerPhone       String?
  borrowerEmail       String?
  borrowerAddress     String?
  employeeId          String?
  employeeName        String?
  principalAmount     Decimal            @db.Decimal(18, 2)
  monthlyInterestRate Decimal            @default(0.012) @db.Decimal(7, 4)
  totalInterest       Decimal            @db.Decimal(18, 2)
  totalDue            Decimal            @db.Decimal(18, 2)
  termMonths          Int                @default(1)
  status              PosCreditStatus    @default(OPEN)
  paidAmount          Decimal?           @db.Decimal(18, 2)
  paymentMethod       PaymentMethod?
  paymentNote         String?
  dueDate             DateTime?
  paidAt              DateTime?
  note                String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  sale                PosSale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  creditCustomer      PosCreditCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organization        Organization       @relation(fields: [organizationId], references: [id])
  branch              Branch             @relation(fields: [branchId], references: [id])
  register            PosRegister?       @relation(fields: [registerId], references: [id])
  shift               PosShift           @relation(fields: [shiftId], references: [id])
  cashier             User               @relation("PosCreditSaleCashier", fields: [cashierId], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@index([branchId])
  @@index([registerId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([borrowerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

/// Individual line item within a POS sale.
model PosSaleLine {
  id                 String  @id @default(uuid())
  saleId             String
  productId          String
  productName        String
  productSku         String?
  productBarcode     String?
  qty                Int
  unitPrice          Decimal @db.Decimal(18, 2)
  priceType          String  @default("UNIT")
  taxAmount          Decimal @db.Decimal(18, 2)
  taxType            String  @default("VAT_ABLE")
  taxRate            Decimal @default(10) @db.Decimal(5, 2)
  cityTaxRate        Decimal @default(0) @db.Decimal(5, 2)
  cityTaxAmount      Decimal @default(0) @db.Decimal(18, 2)
  classificationCode String  @default("4711000")
  taxProductCode     String?
  measureUnit        String  @default("pcs")
  discount           Decimal @db.Decimal(18, 2)
  lineTotal          Decimal @db.Decimal(18, 2)
  sale               PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashDrawerEventType {
  PAID_IN
  PAID_OUT
  OPEN_DRAWER
}

enum PosSaleStatus {
