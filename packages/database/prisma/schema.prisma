// ─────────────────────────────────────────────────────────────────────────
// Direct Messaging (Messenger-like peer-to-peer chat)
// ─────────────────────────────────────────────────────────────────────────
model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType          @default(DIRECT)
  name         String?
  avatarUrl    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           DmType       @default(TEXT)
  content        String
  fileName       String?
  fileSize       Int?
  duration       Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

enum ConversationType {
  DIRECT
  GROUP
}

enum DmType {
  TEXT
  VOICE
  IMAGE
  FILE
}

// ─────────────────────────────────────────────────────────────────────────
// POS Shift & Structured Sales
// ─────────────────────────────────────────────────────────────────────────

/// Cashier shift — tracks opening/closing cash and links sales.
model PosShift {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  registerId     String?
  cashierId      String
  status         ShiftStatus  @default(OPEN)
  openingCash    Decimal      @db.Decimal(18, 2)
  closingCash    Decimal?     @db.Decimal(18, 2)
  expectedCash   Decimal?     @db.Decimal(18, 2)
  cashDifference Decimal?     @db.Decimal(18, 2)
  cashCount       Json?
  cashCountedAt   DateTime?
  note           String?
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  register       PosRegister? @relation(fields: [registerId], references: [id])
  cashier        User         @relation("PosShiftCashier", fields: [cashierId], references: [id])
  sales          PosSale[]

  @@index([organizationId])
  @@index([branchId])
  @@index([cashierId])
  @@index([status])
  @@index([openedAt])
}

model PosCashDrawerEvent {
  id             String              @id @default(uuid())
  organizationId String
  branchId       String
  registerId     String?
  shiftId        String
  cashierId      String
  type           CashDrawerEventType
  amount         Decimal             @db.Decimal(18, 2)
  note           String?
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([branchId])
  @@index([registerId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([type])
  @@index([createdAt])
}

/// Structured POS sale record.
model PosSale {
  id               String        @id @default(uuid())
  receiptNo        String        @unique
  organizationId   String
  branchId         String
  registerId       String?
  shiftId          String
  cashierId        String
  status           PosSaleStatus @default(COMPLETED)
  paymentMethod    String
  subtotal         Decimal       @db.Decimal(18, 2)
  taxTotal         Decimal       @db.Decimal(18, 2)
  discountTotal    Decimal       @db.Decimal(18, 2)
  grandTotal       Decimal       @db.Decimal(18, 2)
  note             String?
  ebarimtStatus    String?
  ebarimtBillId    String?
  ebarimtReceiptId String?
  ebarimtQrData    String?
  ebarimtLottery   String?
  ebarimtDate      DateTime?
  ebarimtError     String?
  ebarimtPayload   Json?
  ebarimtSyncedAt  DateTime?
  voidedAt         DateTime?
  voidReason       String?
  voidedById       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id])
  branch           Branch        @relation(fields: [branchId], references: [id])
  register         PosRegister?  @relation(fields: [registerId], references: [id])
  shift            PosShift      @relation(fields: [shiftId], references: [id])
  cashier          User          @relation("PosSaleCashier", fields: [cashierId], references: [id])
  lines            PosSaleLine[]

  @@index([organizationId])
  @@index([branchId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([status])
  @@index([createdAt])
}

/// Individual line item within a POS sale.
model PosSaleLine {
  id          String  @id @default(uuid())
  saleId      String
  productId   String
  productName String
  productSku  String?
  qty         Int
  unitPrice   Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @db.Decimal(18, 2)
  discount    Decimal @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
  sale        PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashDrawerEventType {
  PAID_IN
  PAID_OUT
  OPEN_DRAWER
}

enum PosSaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaidAccessSourceType {
  PROJECT
  FRANCHISE
  SERVICE
}

enum MPointLedgerType {
  EARN
  SPEND
  ADJUST
}

enum ContractStatus {
  PENDING
  SIGNED
  EXPIRED
  TAMPERED
  REFUNDED
}

model Contract {
  id                String             @id @default(uuid())
  version           String             @default("v1.0")
  status            ContractStatus     @default(PENDING)
  userId            String
  organizationId    String?
  feePlan           String?
  isPaid            Boolean            @default(false)
  isTemplate        Boolean            @default(false)
  templateId        String?
  pdfUrl            String?
  documentHash      String?
  otpSecret         String?
  adminSignature    String?
  adminName         String?
  adminTitle        String?
  adminStamp        String?
  qpayInvoiceId     String?
  systemQrInvoiceId String?
  paymentSystem     String?            @default("QPAY")
  memberData        Json?
  memberSignature   String?
  headerData        Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  signedAt          DateTime?
  user              User               @relation(fields: [userId], references: [id])
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  auditLogs         ContractAuditLog[]
  template          Contract?          @relation("ContractSubmissions", fields: [templateId], references: [id])
  submissions       Contract[]         @relation("ContractSubmissions")

  @@index([userId])
  @@index([organizationId])
  @@index([documentHash])
  @@index([templateId])
  @@index([isTemplate])
}

model ContractAuditLog {
  id         String   @id @default(uuid())
  contractId String
  action     String // FORM_SUBMITTED, OTP_VERIFIED, PDF_GENERATED, SIGNED
  ipAddress  String?
  userAgent  String?
  deviceInfo Json?
  timestamp  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([timestamp])
}

model AssociationMemberRegistration {
  id               String                    @id @default(uuid())
  lastName         String
  firstName        String
  education        String?
  profession       String?
  organizationName String
  businessActivity String?
  foundedYear      String?
  address          String
  experience       String?
  phone            String
  membershipType   AssociationMembershipType
  durationMonths   Int?
  status           ApprovalStatus            @default(PENDING)
  adminNote        String?
  reviewedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([status])
