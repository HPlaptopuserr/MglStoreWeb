generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                    @id @default(uuid())
  email                        String                    @unique
  registerNumber               String?                   @unique
  role                         PlatformRole              @default(USER)
  isPrime                      Boolean                   @default(false)
  membershipPaidAt             DateTime?
  membershipStartedAt          DateTime?
  membershipExpiresAt          DateTime?
  membershipDiscountPhone      String?
  isActive                     Boolean                   @default(true)
  emailVerified                Boolean                   @default(false)
  termsAcceptedAt              DateTime?
  marketingConsent             Boolean                   @default(false)
  lastLoginAt                  DateTime?
  onboardingSource             OnboardingSource          @default(ADMIN)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  deletedAt                    DateTime?
  passwordHash                 String?
  addresses                    Address[]
  attendanceRecords            AttendanceRecord[]        @relation("AttendanceRecordUser")
  auditLogs                    AuditLog[]
  initiatedCardAttempts        CardPaymentAttempt[]      @relation("CardPaymentAttemptInitiatedBy")
  chatSessions                 ChatSession[]             @relation("UserChatSessions")
  courierLocationHistories     CourierLocationHistory[]  @relation("CourierLocationHistoryUser")
  deliveries                   Delivery[]                @relation("CourierDeliveries")
  forms                        Form[]                    @relation("FormCreatedBy")
  inventoryLedgers             InventoryLedger[]         @relation("InventoryLedgerCreatedBy")
  orders                       Order[]                   @relation("CustomerOrders")
  orderDispatchResponses       OrderDispatchAttempt[]    @relation("OrderDispatchAttemptRespondedBy")
  changedOrderHistories        OrderHistory[]            @relation("OrderHistoryChangedBy")
  organizationMemberships      OrganizationMember[]
  passwordResetTokens          PasswordResetToken[]      @relation("UserPasswordResetTokens")
  reviewedPosRegisters         PosRegister[]             @relation("PosRegisterReviewedBy")
  reviewedCardTerminalRequests CardTerminalRequest[]     @relation("CardTerminalRequestReviewedBy")
  posts                        Post[]                    @relation("PostAuthor")
  reviewedProductRequests      ProductRequest[]          @relation("ReviewedProductRequests")
  submittedProductRequests     ProductRequest[]          @relation("SubmittedProductRequests")
  profile                      Profile?
  paidAccessPurchases          PaidAccessPurchase[]
  mPointLedgers                MPointLedger[]
  initiatedQPayInvoices        QPayInvoice[]             @relation("QPayInvoiceInitiatedBy")
  approvedFromRequest          RegistrationRequest?      @relation("ApprovedUserRegistrationRequest")
  reviewedRegistrationRequests RegistrationRequest[]     @relation("ReviewedRegistrationRequests")
  resolvedReturnRequests       ReturnRequest[]           @relation("ReturnRequestResolvedBy")
  assignedServiceRequests      ServiceRequest[]          @relation("ServiceRequestAssignedTo")
  requestedServiceRequests     ServiceRequest[]          @relation("ServiceRequestRequestedBy")
  driverDispatches             StockDispatch[]           @relation("DriverDispatches")
  confirmedPayments            StockRequestPayment[]     @relation("PaymentConfirmations")
  sessions                     UserSession[]
  vendorSetupTokens            VendorSetupToken[]        @relation("UserVendorSetupTokens")
  createdWarehouses            Warehouse[]               @relation("WarehouseCreatedBy")
  warehouseAssignments         WarehouseOrganization[]   @relation("WarehouseAssignedBy")
  warehouseSetupTokens         WarehouseSetupToken[]     @relation("UserWarehouseSetupTokens")
  requestedStockRequests       WarehouseStockRequest[]   @relation("StockRequestsRequested")
  reviewedStockRequests        WarehouseStockRequest[]   @relation("StockRequestsReviewed")
  returnApprovals              DispatchReturn[]          @relation("ReturnApprovals")
  orgJoinRequests              OrgJoinRequest[]          @relation("UserOrgJoinRequests")
  conversationParticipants     ConversationParticipant[]
  sentDirectMessages           DirectMessage[]           @relation("DirectMessageSender")
  posShifts                    PosShift[]                @relation("PosShiftCashier")
  posSales                     PosSale[]                 @relation("PosSaleCashier")
  contracts                    Contract[]

  @@index([role])
  @@index([isPrime])
  @@index([membershipExpiresAt])
  @@index([membershipDiscountPhone])
  @@index([isActive])
  @@index([deletedAt])
  @@index([onboardingSource])
}

model Profile {
  userId         String    @id
  fullName       String
  phoneNumber    String?
  avatarUrl      String?
  birthDate      DateTime?
  gender         Gender?
  birthPlaceCode String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  refreshHash String    @unique
  userAgent   String?
  ip          String?
  deviceId    String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model VendorSetupToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("UserVendorSetupTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model WarehouseSetupToken {
  id          String    @id @default(uuid())
  userId      String
  warehouseId String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("UserWarehouseSetupTokens", fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation("WarehouseSetupTokens", fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([warehouseId])
  @@index([token])
  @@index([expiresAt])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RegistrationRequest {
  id                   String           @id @default(uuid())
  email                String
  source               OnboardingSource @default(SELF_SERVICE)
  status               ApprovalStatus   @default(PENDING)
  fullName             String?
  phoneNumber          String?
  organizationName     String?
  organizationType     OrgType?
  registerNumber       String?
  taxId                String?
  organizationEmail    String?
  organizationPhone    String?
  organizationAddress  String?
  note                 String?
  rejectReason         String?
  reviewedById         String?
  approvedUserId       String?          @unique
  reviewedAt           DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  passwordHash         String?
  businessCategory     String?
  operatingYears       Int?
  inviteToken          String?          @unique
  inviteTokenExpiresAt DateTime?
  requestedOrgType     OrgType          @default(SUPPLIER)
  approvedUser         User?            @relation("ApprovedUserRegistrationRequest", fields: [approvedUserId], references: [id])
  reviewedBy           User?            @relation("ReviewedRegistrationRequests", fields: [reviewedById], references: [id])

  @@index([email])
  @@index([inviteToken])
  @@index([status])
  @@index([requestedOrgType])
  @@index([source])
  @@index([reviewedById])
  @@index([createdAt])
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  email          String
  organizationId String
  role           OrgRole      @default(OWNER)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
}

model JobPosition {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  description  String?
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([isActive])
  @@index([sortOrder])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id                 String         @id @default(uuid())
  firstName          String
  lastName           String
  phone              String
  registerNumber     String?
  age                Int?
  gender             Gender?
  address            String?
  education          String?
  salaryExpect       String?
  experience         String?
  professionalSkills String?
  personalSkills     String?
  languages          String?
  status             ApprovalStatus @default(PENDING)
  note               String?
  rejectReason       String?
  reviewedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  jobPositionId      String?
  jobPosition        JobPosition?   @relation(fields: [jobPositionId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([jobPositionId])
}

model BusinessCategory {
  id        String             @id @default(uuid())
  slug      String             @unique
  name      String
  icon      String?
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  level     Int                @default(0)
  parentId  String?
  parent    BusinessCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  BusinessCategory[] @relation("CategoryHierarchy")
  products  Product[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([parentId])
  @@index([level])
}

model Organization {
  id                           String                  @id @default(uuid())
  name                         String
  slug                         String                  @unique
  taxId                        String                  @unique
  type                         OrgType                 @default(SUPPLIER)
  status                       OrgStatus               @default(ACTIVE)
  isVerified                   Boolean                 @default(false)
  email                        String?
  phone                        String?
  logoUrl                      String?
  address                      String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  deletedAt                    DateTime?
  businessCategory             String?
  bannerUrl                    String?
  customerCount                String?                 @default("0")
  deliveryPrice                String?
  deliveryText                 String?
  description                  String?
  openingHours                 String[]                @default([])
  operatingYears               Int                     @default(1)
  rating                       Float                   @default(5)
  reviewCount                  Int                     @default(0)
  shortDescription             String?
  deletedBy                    String?
  deletionReason               String?
  scheduledPermanentDeletionAt DateTime?
  maxMembers                   Int                     @default(5)
  qpayMerchantId               String?                 @unique
  qpayMerchantKey              String?
  qpayInvoiceCode              String?
  qpayBankAccounts             Json?
  qpayEnabled                  Boolean                 @default(false)
  qpayConnectedAt              DateTime?
  webQpayMerchantId            String?                 @unique
  webQpayMerchantKey           String?
  webQpayInvoiceCode           String?
  webQpayBankAccounts          Json?
  webQpayEnabled               Boolean                 @default(false)
  webQpayConnectedAt           DateTime?
  minuAgentEnabled             Boolean                 @default(false)
  minuAgentUsername            String?
  minuAgentPassword            String?
  minuAgentBranchId            String?
  minuAgentConnectedAt         DateTime?
  subdomainEnabled             Boolean                 @default(false)
  planType                     String?
  planActivatedAt              DateTime?
  planExpiresAt                DateTime?
  trialUsed                    Boolean                 @default(false)
  attendanceRecords            AttendanceRecord[]      @relation("OrgAttendanceRecords")
  attendanceZones              AttendanceZone[]
  branches                     Branch[]
  investorProfile              InvestorProfile?
  orders                       Order[]
  invites                      OrganizationInvite[]
  members                      OrganizationMember[]
  posRegisters                 PosRegister[]
  feedPosts                    Post[]                  @relation("OrganizationPosts")
  products                     Product[]
  productRequests              ProductRequest[]
  servicePosts                 ServicePost[]
  serviceRequests              ServiceRequest[]
  stockDispatches              StockDispatch[]         @relation("OrganizationDispatches")
  stockRequestPayments         StockRequestPayment[]   @relation("OrganizationStockPayments")
  warehouseAssignments         WarehouseOrganization[]
  stockRequests                WarehouseStockRequest[] @relation("OrganizationStockRequests")
  dispatchReturns              DispatchReturn[]        @relation("OrganizationReturns")
  joinRequests                 OrgJoinRequest[]        @relation("OrgJoinRequests")
  posShifts                    PosShift[]
  posSales                     PosSale[]
  contracts                    Contract[]
  upgradePlans                 OrgUpgradePlan[]
  cardTerminalRequests         CardTerminalRequest[]

  @@index([type])
  @@index([status])
  @@index([deletedAt])
  @@index([scheduledPermanentDeletionAt])
  @@index([subdomainEnabled])
}

model CardTerminalRequest {
  id                String                    @id @default(uuid())
  organizationId    String
  contactName       String
  contactPhone      String
  contactEmail      String?
  providerType      String // e.g. "MONPAY", "GOLOMT", "TDB", etc.
  businessNote      String?
  status            CardTerminalRequestStatus @default(PENDING)
  adminNote         String?
  // credentials set by admin after card terminal company approves
  cardTerminalId    String?
  terminalBridgeUrl String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy        User?                     @relation("CardTerminalRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model OrgUpgradePlan {
  id             String            @id @default(uuid())
  organizationId String
  planId         String?
  planType       String
  invoiceId      String            @unique
  invoiceNo      String            @unique
  qrText         String            @default("")
  amount         Decimal           @db.Decimal(18, 2)
  status         PlanPaymentStatus @default(PENDING)
  paidAt         DateTime?
  expiresAt      DateTime?
  grantedByAdmin Boolean           @default(false)
  grantNote      String?
  grantedById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           UpgradePlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@index([invoiceId])
  @@index([createdAt])
}

model UpgradePlan {
  id            String           @id @default(uuid())
  code          String           @unique
  name          String
  description   String?
  price         Decimal          @db.Decimal(18, 2)
  durationDays  Int
  maxProducts   Int
  maxImages     Int
  maxCategories Int
  hasBanner     Boolean          @default(false)
  hasAnalytics  Boolean          @default(false)
  isTrial       Boolean          @default(false)
  badge         String?
  isRecommended Boolean          @default(false)
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  invoices      OrgUpgradePlan[]

  @@index([isActive])
  @@index([sortOrder])
}

model ServicePost {
  id             String             @id @default(uuid())
  organizationId String
  title          String
  description    String?
  priceText      String?
  tags           String[]           @default([])
  isActive       Boolean            @default(true)
  viewCount      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id])
  images         ServicePostImage[]
  requests       ServiceRequest[]

  @@index([organizationId, isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

model ServicePostImage {
  id            String      @id @default(uuid())
  servicePostId String
  url           String
  servicePost   ServicePost @relation(fields: [servicePostId], references: [id], onDelete: Cascade)

  @@index([servicePostId])
}

model InvestorProfile {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  tier            InvestorTier @default(INVESTOR)
  featured        Boolean      @default(false)
  priority        Int          @default(0)
  publiclyVisible Boolean      @default(true)
  investmentLevel String?
  description     String?
  joinedAt        DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([featured])
  @@index([priority])
  @@index([publiclyVisible])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole      @default(STAFF)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isPrimary      Boolean      @default(false)
  capabilities   Capability[] @default([])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
}

/// A request from a user to join an organization.
/// OWNER/ADMIN of the org can approve or reject.
model OrgJoinRequest {
  id             String            @id @default(uuid())
  userId         String
  organizationId String
  status         JoinRequestStatus @default(PENDING)
  message        String?
  rejectedReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation("UserOrgJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization      @relation("OrgJoinRequests", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Branch {
  id                    String                 @id @default(uuid())
  organizationId        String
  name                  String
  address               String
  lat                   Float?
  lng                   Float?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  attendanceZones       AttendanceZone[]
  organization          Organization           @relation(fields: [organizationId], references: [id])
  posRegisters          PosRegister[]
  posShifts             PosShift[]
  posSales              PosSale[]
  orderAssignments      Order[]                @relation("OrderAssignedBranch")
  orderDispatchAttempts OrderDispatchAttempt[]

  @@index([organizationId])
  @@index([deletedAt])
}

model PosRegister {
  id                String               @id @default(uuid())
  organizationId    String
  branchId          String
  name              String
  label             String?
  cardEnabled       Boolean              @default(false)
  cardProviderType  String?
  cardTerminalId    String?
  terminalBridgeUrl String?
  qpayEnabled       Boolean              @default(false)
  qpayMerchantId    String?
  qpayTerminalId    String?
  isActive          Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  activationStatus  PosActivationStatus  @default(PENDING)
  rejectReason      String?
  reviewedAt        DateTime?
  reviewedById      String?
  cardAttempts      CardPaymentAttempt[]
  branch            Branch               @relation(fields: [branchId], references: [id])
  organization      Organization         @relation(fields: [organizationId], references: [id])
  reviewedBy        User?                @relation("PosRegisterReviewedBy", fields: [reviewedById], references: [id])
  qpayInvoices      QPayInvoice[]
  posShifts         PosShift[]
  posSales          PosSale[]

  @@unique([organizationId, branchId, name])
  @@unique([cardProviderType, cardTerminalId])
  @@unique([qpayMerchantId, qpayTerminalId])
  @@index([organizationId])
  @@index([branchId])
  @@index([isActive])
  @@index([activationStatus])
  @@index([deletedAt])
}

model Address {
  id             String    @id @default(uuid())
  userId         String
  label          String?
  fullAddress    String
  city           String?
  district       String?
  khoroo         String?
  entrance       String?
  apartment      String?
  lat            Float?
  lng            Float?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[]   @relation("OrderShippingAddressRef")

  @@index([userId])
  @@index([isDefault])
  @@index([deletedAt])
}

model Category {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  parentId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryHierarchy")
  products        Product[]
  productRequests ProductRequest[]

  @@index([parentId])
}

model Product {
  id                   String                      @id @default(uuid())
  organizationId       String
  name                 String
  description          String?
  sku                  String?
  barcode              String?
  unit                 String?
  price                Decimal                     @db.Decimal(18, 2)
  costPrice            Decimal?                    @db.Decimal(18, 2)
  /// Denormalized cache. Canonical stock lives in WarehouseInventory.quantity.
  /// Updated by POS sales and inventory operations. Do not treat as source of truth
  /// when warehouse management is active for this product.
  stock                Int                         @default(0)
  supplyType           ProductSupplyType           @default(IN_STOCK)
  preorderLeadTimeDays Int?
  preorderNote         String?
  isActive             Boolean                     @default(true)
  categoryId           String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?
  businessCategoryId   String?
  discounts            Discount[]
  inventoryLogs        InventoryLedger[]
  orderItems           OrderItem[]
  businessCategory     BusinessCategory?           @relation(fields: [businessCategoryId], references: [id])
  category             Category?                   @relation(fields: [categoryId], references: [id])
  organization         Organization                @relation(fields: [organizationId], references: [id])
  images               ProductImage[]
  productRequests      ProductRequest[]
  warehouseInventories WarehouseInventory[]
  stockRequestItems    WarehouseStockRequestItem[] @relation("StockRequestProducts")
  posSaleLines         PosSaleLine[]
  returnItems          DispatchReturnItem[]        @relation("ReturnProducts")

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@index([categoryId])
  @@index([businessCategoryId])
  @@index([deletedAt])
  @@index([name])
  @@index([barcode])
  @@index([supplyType])
}

model ProductRequest {
  id             String                @id @default(uuid())
  type           ProductRequestType    @default(CREATE)
  organizationId String
  submittedById  String
  reviewedById   String?
  productId      String?
  status         ProductApprovalStatus @default(PENDING)
  name           String
  description    String?
  sku            String?
  price          Decimal               @db.Decimal(18, 2)
  costPrice      Decimal?              @db.Decimal(18, 2)
  stock          Int                   @default(0)
  categoryId     String?
  rejectReason   String?
  reviewNote     String?
  submittedAt    DateTime              @default(now())
  reviewedAt     DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  category       Category?             @relation(fields: [categoryId], references: [id])
  organization   Organization          @relation(fields: [organizationId], references: [id])
  product        Product?              @relation(fields: [productId], references: [id])
  reviewedBy     User?                 @relation("ReviewedProductRequests", fields: [reviewedById], references: [id])
  submittedBy    User                  @relation("SubmittedProductRequests", fields: [submittedById], references: [id])
  images         ProductRequestImage[]

  @@index([organizationId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([status])
  @@index([productId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([organizationId, sku])
}

model ProductRequestImage {
  id               String         @id @default(uuid())
  productRequestId String
  url              String
  productRequest   ProductRequest @relation(fields: [productRequestId], references: [id], onDelete: Cascade)

  @@index([productRequestId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Discount {
  id         String    @id @default(uuid())
  productId  String
  percent    Int
  validUntil DateTime
  createdAt  DateTime  @default(now())
  isActive   Boolean   @default(true)
  updatedAt  DateTime  @updatedAt
  validFrom  DateTime?
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([validUntil])
}

model InventoryLedger {
  id            String          @id @default(uuid())
  productId     String
  change        Int
  reason        InventoryReason
  note          String?
  createdAt     DateTime        @default(now())
  createdById   String?
  referenceId   String?
  referenceType String?
  createdBy     User?           @relation("InventoryLedgerCreatedBy", fields: [createdById], references: [id])
  product       Product         @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([reason])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([createdAt])
}

model Order {
  id                 String                 @id @default(uuid())
  organizationId     String
  customerId         String
  status             OrderStatus            @default(PENDING)
  paymentStatus      PaymentStatus          @default(PENDING)
  paymentMethod      PaymentMethod?
  shippingAddress    String
  phone              String
  note               String?
  shippingAddressId  String?
  branchId           String?
  customerLat        Float?
  customerLng        Float?
  deliveryCode       String?
  subtotal           Decimal                @db.Decimal(18, 2)
  discountAmount     Decimal                @default(0) @db.Decimal(18, 2)
  deliveryFee        Decimal                @default(0) @db.Decimal(18, 2)
  total              Decimal                @db.Decimal(18, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  orderNumber        String                 @unique
  delivery           Delivery?
  branch             Branch?                @relation("OrderAssignedBranch", fields: [branchId], references: [id])
  customer           User                   @relation("CustomerOrders", fields: [customerId], references: [id])
  organization       Organization           @relation(fields: [organizationId], references: [id])
  shippingAddressRef Address?               @relation("OrderShippingAddressRef", fields: [shippingAddressId], references: [id])
  history            OrderHistory[]
  dispatchAttempts   OrderDispatchAttempt[]
  items              OrderItem[]
  payments           PaymentAttempt[]
  returnRequest      ReturnRequest?

  @@index([organizationId, status])
  @@index([customerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([shippingAddressId])
  @@index([branchId])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderDispatchAttempt {
  id             String                     @id @default(uuid())
  orderId        String
  branchId       String
  organizationId String
  status         OrderDispatchAttemptStatus @default(PENDING)
  sequence       Int
  distanceKm     Float?
  requestedAt    DateTime                   @default(now())
  respondedAt    DateTime?
  respondedById  String?
  expiresAt      DateTime?
  note           String?
  branch         Branch                     @relation(fields: [branchId], references: [id])
  order          Order                      @relation(fields: [orderId], references: [id])
  respondedBy    User?                      @relation("OrderDispatchAttemptRespondedBy", fields: [respondedById], references: [id])

  @@unique([orderId, branchId])
  @@index([orderId, status])
  @@index([branchId, status])
  @@index([organizationId, status])
  @@index([requestedAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  price       Decimal @db.Decimal(18, 2)
  subtotal    Decimal @db.Decimal(18, 2)
  productName String
  productSku  String?
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderHistory {
  id          String       @id @default(uuid())
  orderId     String
  timestamp   DateTime     @default(now())
  changedById String?
  note        String?
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedBy   User?        @relation("OrderHistoryChangedBy", fields: [changedById], references: [id])
  order       Order        @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([timestamp])
  @@index([changedById])
}

model PaymentAttempt {
  id            String        @id @default(uuid())
  orderId       String
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(18, 2)
  providerRef   String?
  rawPayload    Json?
  failureReason String?
  paidAt        DateTime?
  refundedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
}

model Delivery {
  id           String         @id @default(uuid())
  orderId      String         @unique
  courierId    String?
  status       DeliveryStatus @default(WAITING)
  trackingCode String?
  pickupTime   DateTime?
  deliveredAt  DateTime?
  proofImage   String?
  updatedAt    DateTime       @updatedAt
  cancelledAt  DateTime?
  createdAt    DateTime       @default(now())
  courier      User?          @relation("CourierDeliveries", fields: [courierId], references: [id])
  order        Order          @relation(fields: [orderId], references: [id])

  @@index([courierId])
  @@index([status])
  @@index([createdAt])
}

model CourierLocationHistory {
  id        String   @id @default(uuid())
  userId    String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  user      User     @relation("CourierLocationHistoryUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String       @unique
  reason       String
  status       ReturnStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id])
  resolvedBy   User?        @relation("ReturnRequestResolvedBy", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([resolvedById])
  @@index([createdAt])
}

model ServiceRequest {
  id             String               @id @default(uuid())
  organizationId String
  servicePostId  String?
  requestedById  String
  type           ServiceRequestType
  title          String
  description    String?
  status         ServiceRequestStatus @default(PENDING)
  adminNote      String?
  assignedToId   String?
  estimatedPrice Decimal?             @db.Decimal(18, 2)
  finalPrice     Decimal?             @db.Decimal(18, 2)
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  assignedTo     User?                @relation("ServiceRequestAssignedTo", fields: [assignedToId], references: [id])
  organization   Organization         @relation(fields: [organizationId], references: [id])
  requestedBy    User                 @relation("ServiceRequestRequestedBy", fields: [requestedById], references: [id])
  servicePost    ServicePost?         @relation(fields: [servicePostId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([servicePostId])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Warehouse {
  id              String                  @id @default(uuid())
  name            String
  address         String
  capacity        Int                     @default(0)
  lat             Float?
  lng             Float?
  createdById     String?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  city            String                  @default("")
  district        String                  @default("")
  phone           String?
  dispatches      StockDispatch[]         @relation("WarehouseDispatches")
  createdBy       User?                   @relation("WarehouseCreatedBy", fields: [createdById], references: [id])
  inventories     WarehouseInventory[]
  organizations   WarehouseOrganization[]
  setupTokens     WarehouseSetupToken[]   @relation("WarehouseSetupTokens")
  stockRequests   WarehouseStockRequest[] @relation("WarehouseStockRequests")
  dispatchReturns DispatchReturn[]        @relation("WarehouseReturns")

  @@index([createdById])
  @@index([isActive])
  @@index([deletedAt])
}

model WarehouseOrganization {
  id             String       @id @default(uuid())
  warehouseId    String
  organizationId String
  assignedAt     DateTime     @default(now())
  assignedById   String?
  assignedBy     User?        @relation("WarehouseAssignedBy", fields: [assignedById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, organizationId])
  @@index([warehouseId])
  @@index([organizationId])
}

model WarehouseInventory {
  id              String    @id @default(uuid())
  warehouseId     String
  productId       String
  quantity        Int       @default(0)
  minQuantity     Int       @default(0)
  maxQuantity     Int?
  location        String?
  batchNumber     String?
  expiryDate      DateTime?
  lastRestockedAt DateTime?
  lastAuditedAt   DateTime?
  note            String?
  showOnWeb       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@index([quantity])
  @@index([showOnWeb])
}

model WarehouseStockRequest {
  id              String                      @id @default(uuid())
  requestNumber   String                      @unique
  organizationId  String
  warehouseId     String
  status          StockRequestStatus          @default(PENDING)
  note            String?
  deliveryAddress String?
  deliveryPhone   String?
  requestedById   String
  reviewedById    String?
  reviewNote      String?
  reviewedAt      DateTime?
  requestedAt     DateTime                    @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  dispatch        StockDispatch?
  payment         StockRequestPayment?
  organization    Organization                @relation("OrganizationStockRequests", fields: [organizationId], references: [id])
  requestedBy     User                        @relation("StockRequestsRequested", fields: [requestedById], references: [id])
  reviewedBy      User?                       @relation("StockRequestsReviewed", fields: [reviewedById], references: [id])
  warehouse       Warehouse                   @relation("WarehouseStockRequests", fields: [warehouseId], references: [id])
  items           WarehouseStockRequestItem[]

  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([requestedAt])
}

model WarehouseStockRequestItem {
  id               String                @id @default(uuid())
  requestId        String
  productId        String
  quantity         Int
  approvedQuantity Int?
  note             String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  product          Product               @relation("StockRequestProducts", fields: [productId], references: [id])
  request          WarehouseStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId])
  @@index([requestId])
  @@index([productId])
}

model StockRequestPayment {
  id             String                @id @default(uuid())
  invoiceNumber  String                @unique
  requestId      String                @unique
  organizationId String
  totalAmount    Decimal               @db.Decimal(18, 2)
  paidAmount     Decimal               @default(0) @db.Decimal(18, 2)
  status         PaymentStatus         @default(PENDING)
  paymentMethod  PaymentMethod?
  paidAt         DateTime?
  paidBy         String?
  transactionId  String?
  note           String?
  confirmedById  String?
  confirmedAt    DateTime?
  dueDate        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  confirmedBy    User?                 @relation("PaymentConfirmations", fields: [confirmedById], references: [id])
  organization   Organization          @relation("OrganizationStockPayments", fields: [organizationId], references: [id])
  request        WarehouseStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

/// Dispatch order created when admin approves a stock request.
/// Warehouse operator sees this and confirms dispatch → inventory deducted.
model StockDispatch {
  id             String                @id @default(uuid())
  dispatchNumber String                @unique
  requestId      String                @unique
  warehouseId    String
  organizationId String
  status         DispatchStatus        @default(PENDING)
  driverId       String?
  driverName     String?
  driverPhone    String?
  vehicleNumber  String?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  note           String?
  padaanUrl      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  driver         User?                 @relation("DriverDispatches", fields: [driverId], references: [id])
  organization   Organization          @relation("OrganizationDispatches", fields: [organizationId], references: [id])
  request        WarehouseStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  warehouse      Warehouse             @relation("WarehouseDispatches", fields: [warehouseId], references: [id])
  returns        DispatchReturn[]

  @@index([warehouseId])
  @@index([organizationId])
  @@index([status])
  @@index([driverId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Dispatch Returns — goods returned after delivery
// ─────────────────────────────────────────────────────────────────────────

/// Return request for defective/wrong goods from a delivered dispatch.
/// Warehouse admin manually approves; approved returns restore inventory.
model DispatchReturn {
  id             String               @id @default(uuid())
  returnNumber   String               @unique
  dispatchId     String
  warehouseId    String
  organizationId String
  status         ReturnStatus         @default(PENDING)
  reason         String?
  note           String?
  rejectReason   String?
  requestedAt    DateTime             @default(now())
  approvedAt     DateTime?
  rejectedAt     DateTime?
  approvedById   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  dispatch       StockDispatch        @relation(fields: [dispatchId], references: [id])
  warehouse      Warehouse            @relation("WarehouseReturns", fields: [warehouseId], references: [id])
  organization   Organization         @relation("OrganizationReturns", fields: [organizationId], references: [id])
  approvedBy     User?                @relation("ReturnApprovals", fields: [approvedById], references: [id])
  items          DispatchReturnItem[]

  @@index([dispatchId])
  @@index([warehouseId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model DispatchReturnItem {
  id        String         @id @default(uuid())
  returnId  String
  productId String
  quantity  Int
  reason    String?
  return    DispatchReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product   Product        @relation("ReturnProducts", fields: [productId], references: [id])

  @@unique([returnId, productId])
  @@index([returnId])
  @@index([productId])
}

model CardPaymentAttempt {
  id              String           @id @default(uuid())
  registerId      String?
  organizationId  String?
  terminalId      String
  bridgeUrl       String?
  amount          Decimal          @db.Decimal(18, 2)
  status          PosPaymentStatus @default(PENDING)
  transactionId   String?
  traceno         String?
  message         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  consumedAt      DateTime?
  initiatedById   String?
  providerPayload Json?
  saleReference   String?
  initiatedBy     User?            @relation("CardPaymentAttemptInitiatedBy", fields: [initiatedById], references: [id])
  register        PosRegister?     @relation(fields: [registerId], references: [id])

  @@index([registerId])
  @@index([status])
  @@index([createdAt])
  @@index([initiatedById])
  @@index([saleReference])
}

model QPayInvoice {
  id             String        @id @default(uuid())
  registerId     String?
  organizationId String?
  amount         Decimal       @db.Decimal(18, 2)
  qrText         String
  status         PosQPayStatus @default(PENDING)
  expiresAt      DateTime
  paidAt         DateTime?
  webhookPayload Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  consumedAt     DateTime?
  initiatedById  String?
  paymentId      String?       @unique
  saleReference  String?
  initiatedBy    User?         @relation("QPayInvoiceInitiatedBy", fields: [initiatedById], references: [id])
  register       PosRegister?  @relation(fields: [registerId], references: [id])

  @@index([registerId])
  @@index([status])
  @@index([expiresAt])
  @@index([initiatedById])
  @@index([saleReference])
}

model PaidAccessPurchase {
  id          String               @id @default(uuid())
  userId      String
  sourceType  PaidAccessSourceType
  itemId      String
  title       String
  fileUrl     String?
  fileName    String?
  amount      Int                  @default(0)
  invoiceId   String?              @unique
  metadata    Json?
  purchasedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, itemId])
  @@index([userId, purchasedAt])
  @@index([sourceType, itemId])
}

model MPointLedger {
  id           String              @id @default(uuid())
  userId       String
  type         MPointLedgerType
  amount       Int
  balanceAfter Int?
  sourceType   PaidAccessSourceType?
  sourceId     String?
  invoiceId    String?             @unique
  description  String
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model PosSaleIdempotency {
  id             String   @id @default(uuid())
  clientSaleId   String
  receiptNo      String   @unique
  organizationId String
  registerId     String?
  response       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, clientSaleId])
  @@index([organizationId])
  @@index([registerId])
  @@index([createdAt])
}

model Post {
  id             String        @id @default(uuid())
  authorId       String
  organizationId String?
  type           PostType      @default(GENERAL)
  content        String
  imageUrls      String[]      @default([])
  tags           String[]      @default([])
  viewCount      Int           @default(0)
  likeCount      Int           @default(0)
  commentCount   Int           @default(0)
  isPinned       Boolean       @default(false)
  isOfficial     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  author         User          @relation("PostAuthor", fields: [authorId], references: [id])
  organization   Organization? @relation("OrganizationPosts", fields: [organizationId], references: [id])
  comments       PostComment[]
  likes          PostLike[]

  @@index([authorId])
  @@index([organizationId])
  @@index([type])
  @@index([isPinned])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

model Form {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  description String?
  fields      Json
  isActive    Boolean        @default(true)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User?          @relation("FormCreatedBy", fields: [createdById], references: [id])
  responses   FormResponse[]

  @@index([slug])
  @@index([isActive])
  @@index([createdById])
  @@index([createdAt])
}

model FormResponse {
  id          String   @id @default(uuid())
  formId      String
  data        Json
  submittedAt DateTime @default(now())
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([submittedAt])
}

model AttendanceZone {
  id             String             @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  lat            Float
  lng            Float
  radiusMeters   Int                @default(500)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  records        AttendanceRecord[]
  branch         Branch?            @relation(fields: [branchId], references: [id])
  organization   Organization       @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([isActive])
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  zoneId         String
  clockIn        DateTime
  clockInLat     Float
  clockInLng     Float
  clockInMethod  AttendanceAuth
  clockOut       DateTime?
  clockOutLat    Float?
  clockOutLng    Float?
  clockOutMethod AttendanceAuth?
  totalMinutes   Int?
  note           String?
  status         AttendanceStatus @default(PRESENT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation("OrgAttendanceRecords", fields: [organizationId], references: [id])
  user           User             @relation("AttendanceRecordUser", fields: [userId], references: [id])
  zone           AttendanceZone   @relation(fields: [zoneId], references: [id])

  @@index([userId, clockIn])
  @@index([organizationId, clockIn])
  @@index([zoneId])
}

model ChatSession {
  id          String            @id @default(cuid())
  visitorId   String
  userId      String?
  displayName String?
  status      ChatSessionStatus @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  messages    ChatMessage[]
  user        User?             @relation("UserChatSessions", fields: [userId], references: [id])

  @@index([visitorId])
  @@index([userId])
  @@index([status, updatedAt])
}

model ChatMessage {
  id        String            @id @default(cuid())
  sessionId String
  sender    ChatMessageSender
  senderId  String?
  text      String
  createdAt DateTime          @default(now())
  session   ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// ///////////////////////////////////////////////
/// ///////////////////////////////////////////////
enum OrgRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum ProductRequestType {
  CREATE
  UPDATE
}

enum ProductSupplyType {
  IN_STOCK
  CHINA_PREORDER
}

/// Operational capabilities assigned to organization members.
/// Used for fine-grained permission checks beyond the structural OrgRole.
enum Capability {
  POS_CASHIER
  DELIVERY_DRIVER
  STOCK_MANAGER
  ORDER_PROCESSOR
}

enum PlatformRole {
  ADMIN
  USER
  SUPER_ADMIN
  HR_ADMIN
  CONTENT_ADMIN
  PARTNER_ADMIN
  WAREHOUSE_ADMIN
  FINANCE_ADMIN
  SERVICE_ADMIN
  LAWYER
}

enum OrgType {
  SUPPLIER
  BUSINESS_CUSTOMER
  VENDOR
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum InvestorTier {
  INVESTOR
  STRATEGIC
  TOP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  WAITING
  PICKING
  DELIVERING
  COMPLETED
  CANCELLED
}

enum OrderDispatchAttemptStatus {
  QUEUED
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  QPAY
  BANK_TRANSFER
}

enum InventoryReason {
  ORDER
  RETURN
  RESTOCK
  MANUAL_ADJUST
  ORDER_CANCEL
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL_STOCK
}

enum Gender {
  MALE
  FEMALE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssociationMembershipType {
  BASIC
  ACTIVE
  BRANCH_COUNCIL
  GOVERNING_COUNCIL
}

enum OnboardingSource {
  ADMIN
  SELF_SERVICE
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum CardTerminalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  PASSWORD_CHANGED
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PAYMENT_CREATED
