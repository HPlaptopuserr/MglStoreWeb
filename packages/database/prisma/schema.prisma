enum RestaurantMealContractStatus {
  ACTIVE
  INACTIVE
}

enum RestaurantMealChargeStatus {
  ACTIVE
  VOIDED
}

/// A zero-interest meal-account agreement with an external organization.
/// Payment collection stays outside MGL Store; only meal usage is recorded.
model RestaurantMealContract {
  id                   String                         @id @default(uuid())
  organizationId       String
  customerOrganization String
  customerRegisterNo   String?
  startDate            DateTime                       @db.Date
  endDate              DateTime                       @db.Date
  status               RestaurantMealContractStatus   @default(ACTIVE)
  note                 String?
  pinHash              String?
  createdById          String
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  organization         Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy            User                           @relation("RestaurantMealContractCreatedBy", fields: [createdById], references: [id])
  members              RestaurantMealContractMember[]
  charges              RestaurantMealCharge[]

  @@index([organizationId, status, startDate, endDate])
  @@index([customerOrganization])
  @@index([customerRegisterNo])
  @@index([createdById])
}

model RestaurantMealContractMember {
  id           String                 @id @default(uuid())
