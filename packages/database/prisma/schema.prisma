generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  investmentTopUps WarehouseInvestmentTopUp[]
  warehouseDividends WarehouseInvestorDividend[] @relation("WarehouseDividendOwner")
  recordedWarehouseDividends WarehouseInvestorDividend[] @relation("WarehouseDividendRecorder")
  warehouseInvestments WarehouseInvestment[] @relation("WarehouseInvestmentOwner")
  recordedWarehouseInvestments WarehouseInvestment[] @relation("WarehouseInvestmentRecorder")

  warehouseViewerAccess WarehouseViewer[] @relation("WarehouseViewerUser")
  grantedWarehouseViewerAccess WarehouseViewer[] @relation("WarehouseViewerGrantor")
  buildingPurchaseContracts BarilgaPurchaseContract[]
  buildingReservations BarilgaReservation[]
  esimPurchases EsimPurchase[]
  warehouseRetailOrders WarehouseRetailOrder[]
  platformAccounts PlatformAccount[]
  createdStocktakes Stocktake[] @relation("StocktakeCreator")
  approvedStocktakes Stocktake[] @relation("StocktakeApprover")

  id                               String                         @id @default(uuid())
  identitySubject                  String?                        @unique
  email                            String                         @unique
  registerNumber                   String?                        @unique
  role                             PlatformRole                   @default(USER)
  isPrime                          Boolean                        @default(false)
  membershipPaidAt                 DateTime?
  membershipStartedAt              DateTime?
  membershipExpiresAt              DateTime?
  membershipDiscountPhone          String?
  isActive                         Boolean                        @default(true)
  emailVerified                    Boolean                        @default(false)
  termsAcceptedAt                  DateTime?
  marketingConsent                 Boolean                        @default(false)
  lastLoginAt                      DateTime?
  onboardingSource                 OnboardingSource               @default(ADMIN)
  createdAt                        DateTime                       @default(now())
  updatedAt                        DateTime                       @updatedAt
  deletedAt                        DateTime?
  passwordHash                     String?
  addresses                        Address[]
  attendanceRecords                AttendanceRecord[]             @relation("AttendanceRecordUser")
  auditLogs                        AuditLog[]
  initiatedCardAttempts            CardPaymentAttempt[]           @relation("CardPaymentAttemptInitiatedBy")
  chatSessions                     ChatSession[]                  @relation("UserChatSessions")
  courierLocationHistories         CourierLocationHistory[]       @relation("CourierLocationHistoryUser")
  deliveries                       Delivery[]                     @relation("CourierDeliveries")
  forms                            Form[]                         @relation("FormCreatedBy")
  inventoryLedgers                 InventoryLedger[]              @relation("InventoryLedgerCreatedBy")
  orders                           Order[]                        @relation("CustomerOrders")
  orderDispatchResponses           OrderDispatchAttempt[]         @relation("OrderDispatchAttemptRespondedBy")
  changedOrderHistories            OrderHistory[]                 @relation("OrderHistoryChangedBy")
  organizationMemberships          OrganizationMember[]
  createdOrganizationTasks         OrganizationTask[]             @relation("OrganizationTaskCreatedBy")
  assignedOrganizationTasks        OrganizationTaskAssignee[]     @relation("OrganizationTaskAssignedUser")
  approvedOrganizationTaskLogs     OrganizationTaskApprovalLog[]  @relation("OrganizationTaskApprovedBy")
  authoredOrganizationTaskComments OrganizationTaskComment[]      @relation("OrganizationTaskCommentAuthor")
  passwordResetTokens              PasswordResetToken[]           @relation("UserPasswordResetTokens")
  reviewedPosRegisters             PosRegister[]                  @relation("PosRegisterReviewedBy")
  reviewedCardTerminalRequests     CardTerminalRequest[]          @relation("CardTerminalRequestReviewedBy")
  posts                            Post[]                         @relation("PostAuthor")
  reviewedProductRequests          ProductRequest[]               @relation("ReviewedProductRequests")
  submittedProductRequests         ProductRequest[]               @relation("SubmittedProductRequests")
  profile                          Profile?
  paidAccessPurchases              PaidAccessPurchase[]
  mPointLedgers                    MPointLedger[]
  initiatedQPayInvoices            QPayInvoice[]                  @relation("QPayInvoiceInitiatedBy")
  approvedFromRequest              RegistrationRequest?           @relation("ApprovedUserRegistrationRequest")
  reviewedRegistrationRequests     RegistrationRequest[]          @relation("ReviewedRegistrationRequests")
  resolvedReturnRequests           ReturnRequest[]                @relation("ReturnRequestResolvedBy")
  assignedServiceRequests          ServiceRequest[]               @relation("ServiceRequestAssignedTo")
  requestedServiceRequests         ServiceRequest[]               @relation("ServiceRequestRequestedBy")
  driverDispatches                 StockDispatch[]                @relation("DriverDispatches")
  confirmedPayments                StockRequestPayment[]          @relation("PaymentConfirmations")
  confirmedStockPaymentEntries     StockRequestPaymentEntry[]     @relation("StockPaymentEntryConfirmations")
  sessions                         UserSession[]
  vendorSetupTokens                VendorSetupToken[]             @relation("UserVendorSetupTokens")
  createdWarehouses                Warehouse[]                    @relation("WarehouseCreatedBy")
  warehouseAssignments             WarehouseOrganization[]        @relation("WarehouseAssignedBy")
  warehouseSetupTokens             WarehouseSetupToken[]          @relation("UserWarehouseSetupTokens")
  requestedStockRequests           WarehouseStockRequest[]        @relation("StockRequestsRequested")
  reviewedStockRequests            WarehouseStockRequest[]        @relation("StockRequestsReviewed")
  returnApprovals                  DispatchReturn[]               @relation("ReturnApprovals")
  orgJoinRequests                  OrgJoinRequest[]               @relation("UserOrgJoinRequests")
  conversationParticipants         ConversationParticipant[]
  sentDirectMessages               DirectMessage[]                @relation("DirectMessageSender")
  pushTokens                       PushToken[]
  posShifts                        PosShift[]                     @relation("PosShiftCashier")
  posSales                         PosSale[]                      @relation("PosSaleCashier")
  receivedPosGoodsReceipts         PosGoodsReceipt[]              @relation("PosGoodsReceiptReceivedBy")
  createdCafeDailyStocks           CafeDailyStock[]               @relation("CafeDailyStockCreatedBy")
  updatedCafeDailyStocks           CafeDailyStock[]               @relation("CafeDailyStockUpdatedBy")
  receivedCafeDailyStockReceipts   CafeDailyStockReceipt[]        @relation("CafeDailyStockReceiptReceivedBy")
  voidedCafeDailyStockReceipts     CafeDailyStockReceipt[]        @relation("CafeDailyStockReceiptVoidedBy")
  posCreditSales                   PosCreditSale[]                @relation("PosCreditSaleCashier")
  posLoyaltyTransactions           PosLoyaltyTransaction[]        @relation("PosLoyaltyCustomer")
  openedRestaurantTickets          RestaurantTicket[]             @relation("RestaurantTicketOpenedBy")
  sentKitchenTickets               KitchenTicket[]                @relation("KitchenTicketSentBy")
  createdRestaurantMealContracts   RestaurantMealContract[]       @relation("RestaurantMealContractCreatedBy")
  restaurantMealCharges            RestaurantMealCharge[]         @relation("RestaurantMealChargeCashier")
  contracts                        Contract[]
  productInteractions              ProductInteraction[]
  productInterestScores            ProductInterestScore[]
  productReviews                   ProductReview[]
  authoredReels                    Reel[]                         @relation("ReelAuthor")
  reviewedReels                    Reel[]                         @relation("ReelReviewedBy")
  reelInteractions                 ReelInteraction[]
  membershipAgents                 MembershipAgent[]              @relation("MembershipAgentUser")
  createdMembershipAgents          MembershipAgent[]              @relation("MembershipAgentCreatedBy")
  membershipReferralCommissions    MembershipReferralCommission[] @relation("MembershipReferralAgentUser")
  organizationGameScores           OrganizationGameScore[]
  deliveryPartnershipRequests      DeliveryPartnership[]          @relation("DeliveryPartnershipRequestedBy")
  deliveryPartnershipResponses     DeliveryPartnership[]          @relation("DeliveryPartnershipRespondedBy")
  warehouseCourierAssignments      WarehouseCourierAssignment[]   @relation("WarehouseAssignedCourier")
  warehouseManualDispatches        WarehouseManualDispatch[]      @relation("WarehouseManualDispatchCreatedBy")
  createdWarehouseGoodsReceipts    WarehouseGoodsReceipt[]        @relation("WarehouseGoodsReceiptCreatedBy")
  confirmedWarehouseGoodsReceipts  WarehouseGoodsReceipt[]        @relation("WarehouseGoodsReceiptConfirmedBy")
  assignedWarehouseCouriers        WarehouseCourierAssignment[]   @relation("WarehouseCourierAssignedBy")
  deliveryDriverProfile            DeliveryDriverProfile?
  salesVisits                      SalesVisit[]
  createdQualityChecklistTemplates QualityChecklistTemplate[]     @relation("QualityTemplateCreator")
  qualityInspections               QualityInspection[]

  @@index([role])
  @@index([isPrime])
  @@index([membershipExpiresAt])
  @@index([membershipDiscountPhone])
  @@index([isActive])
  @@index([deletedAt])
  @@index([onboardingSource])
}

model Profile {
  userId         String    @id
  fullName       String
  phoneNumber    String?
  avatarUrl      String?
  birthDate      DateTime?
  gender         Gender?
  birthPlaceCode String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryDriverProfile {
  userId                   String    @id
  nationalId               String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  vehicleMake              String?
  vehicleModel             String?
  vehiclePlateNumber       String?
  vehicleCategory          String?
  driverLicenseNumber      String?
  driverLicenseDocumentUrl String?
  vehicleDocumentUrl       String?
  insuranceProvider        String?
  insurancePolicyNumber    String?
  insuranceExpiresAt       DateTime?
  insuranceDocumentUrl     String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehiclePlateNumber])
  @@index([insuranceExpiresAt])
}

// Additive staging only: existing authentication still uses User.passwordHash.
// Possession of a platform credential does not grant organization permissions.
enum AccountPlatform {
  STORE
  BUSINESS
  VENDOR
  WAREHOUSE
  ORG
  ADMIN
}

model PlatformAccount {
  id                String          @id @default(uuid())
  userId            String
  platform          AccountPlatform
  passwordHash      String?
  credentialVersion Int             @default(1)
  status            PlatformAccountStatus @default(STAGED)
  migratedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

enum PlatformAccountStatus {
  STAGED
  ACTIVE
  DISABLED
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  refreshHash String    @unique
  userAgent   String?
  ip          String?
  deviceId    String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model VendorSetupToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("UserVendorSetupTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

/// Investor access is separate from operator setup tokens and grants no mutations.
model WarehouseViewer {
  id String @id @default(uuid())
  warehouseId String
  userId String
  grantedById String
  createdAt DateTime @default(now())
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user User @relation("WarehouseViewerUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("WarehouseViewerGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([warehouseId, userId])
  @@index([userId])
}

model WarehouseSetupToken {
  id          String    @id @default(uuid())
  userId      String
  warehouseId String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("UserWarehouseSetupTokens", fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation("WarehouseSetupTokens", fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([warehouseId])
  @@index([token])
  @@index([expiresAt])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RegistrationRequest {
  id                   String           @id @default(uuid())
  email                String
  source               OnboardingSource @default(SELF_SERVICE)
  status               ApprovalStatus   @default(PENDING)
  fullName             String?
  phoneNumber          String?
  organizationName     String?
  organizationType     OrgType?
  registerNumber       String?
  taxId                String?
  organizationEmail    String?
  organizationPhone    String?
  organizationAddress  String?
  note                 String?
  rejectReason         String?
  reviewedById         String?
  approvedUserId       String?          @unique
  reviewedAt           DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  passwordHash         String?
  businessCategory     String?
  operatingYears       Int?
  inviteToken          String?          @unique
  inviteTokenExpiresAt DateTime?
  requestedOrgType     OrgType          @default(SUPPLIER)
  approvedUser         User?            @relation("ApprovedUserRegistrationRequest", fields: [approvedUserId], references: [id])
  reviewedBy           User?            @relation("ReviewedRegistrationRequests", fields: [reviewedById], references: [id])

  @@index([email])
  @@index([inviteToken])
  @@index([status])
  @@index([requestedOrgType])
  @@index([source])
  @@index([reviewedById])
  @@index([createdAt])
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  email          String
  organizationId String
  role           OrgRole      @default(OWNER)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
}

model JobPosition {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  description  String?
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([isActive])
  @@index([sortOrder])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id                 String         @id @default(uuid())
  firstName          String
  lastName           String
  phone              String
  registerNumber     String?
  age                Int?
  gender             Gender?
  address            String?
  education          String?
  salaryExpect       String?
  experience         String?
  professionalSkills String?
  personalSkills     String?
  languages          String?
  status             ApprovalStatus @default(PENDING)
  note               String?
  rejectReason       String?
  reviewedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  jobPositionId      String?
  jobPosition        JobPosition?   @relation(fields: [jobPositionId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([jobPositionId])
}

model BusinessCategory {
  id                    String                 @id @default(uuid())
  slug                  String                 @unique
  name                  String
  icon                  String?
  sortOrder             Int                    @default(0)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  level                 Int                    @default(0)
  parentId              String?
  parent                BusinessCategory?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children              BusinessCategory[]     @relation("CategoryHierarchy")
  products              Product[]
  productInteractions   ProductInteraction[]
  productInterestScores ProductInterestScore[]
  reels                 Reel[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([parentId])
  @@index([level])
}

model Organization {
  businessBuildingEnabled Boolean @default(false)
  buildingProjects BarilgaProject[]
  catalogWarehouse Warehouse? @relation("WarehouseCatalogOwner")
  stocktakes Stocktake[]

  id                               String                       @id @default(uuid())
  name                             String
  nameNormalized                   String?
  slug                             String                       @unique
  taxId                            String                       @unique
  type                             OrgType                      @default(SUPPLIER)
  status                           OrgStatus                    @default(ACTIVE)
  isVerified                       Boolean                      @default(false)
  email                            String?
  phone                            String?
  logoUrl                          String?
  address                          String?
  createdAt                        DateTime                     @default(now())
  updatedAt                        DateTime                     @updatedAt
  deletedAt                        DateTime?
  businessCategory                 String?
  bannerUrl                        String?
  customerCount                    String?                      @default("0")
  deliveryPrice                    String?
  deliveryText                     String?
  description                      String?
  openingHours                     String[]                     @default([])
  operatingYears                   Int                          @default(1)
  rating                           Float                        @default(0)
  reviewCount                      Int                          @default(0)
  soldCount                        Int                          @default(0)
  shortDescription                 String?
  deletedBy                        String?
  deletionReason                   String?
  scheduledPermanentDeletionAt     DateTime?
  maxMembers                       Int                          @default(5)
  qpayMerchantId                   String?                      @unique
  qpayMerchantKey                  String?
  qpayInvoiceCode                  String?
  qpayBankAccounts                 Json?
  qpayEnabled                      Boolean                      @default(false)
  qpayConnectedAt                  DateTime?
  webQpayMerchantId                String?                      @unique
  webQpayMerchantKey               String?
  webQpayInvoiceCode               String?
  webQpayBankAccounts              Json?
  webQpayEnabled                   Boolean                      @default(false)
  webQpayConnectedAt               DateTime?
  minuAgentEnabled                 Boolean                      @default(false)
  minuAgentUsername                String?
  minuAgentPassword                String?
  minuAgentBranchId                String?
  minuAgentConnectedAt             DateTime?
  subdomainEnabled                 Boolean                      @default(false)
  planType                         String?
  planActivatedAt                  DateTime?
  planExpiresAt                    DateTime?
  trialUsed                        Boolean                      @default(false)
  businessPosEnabled               Boolean                      @default(true)
  businessSalesEnabled             Boolean                      @default(true)
  businessOrdersEnabled            Boolean                      @default(true)
  businessInventoryEnabled         Boolean                      @default(true)
  businessAttendanceEnabled        Boolean                      @default(true)
  businessAttendanceManualEnabled  Boolean                      @default(false)
  salesRepVendorRestrictionEnabled Boolean                      @default(false)
  businessTasksEnabled             Boolean                      @default(true)
  businessDeliveryEnabled          Boolean                      @default(false)
  accessPinHash                    String?
  accessPinUpdatedAt               DateTime?
  ceoServiceEnabled                Boolean                      @default(false)
  ceoAdviceNotificationsEnabled    Boolean                      @default(true)
  ceoCalendarRemindersEnabled      Boolean                      @default(true)
  ceoWeeklyDigestEnabled           Boolean                      @default(true)
  ceoRiskAlertsEnabled             Boolean                      @default(true)
  ceoKpiInsightsEnabled            Boolean                      @default(true)
  ceoDecisionBriefEnabled          Boolean                      @default(true)
  tasks                            OrganizationTask[]
  attendanceRecords                AttendanceRecord[]           @relation("OrgAttendanceRecords")
  attendanceZones                  AttendanceZone[]
  branches                         Branch[]
  investorProfile                  InvestorProfile?
  orders                           Order[]
  invites                          OrganizationInvite[]
  members                          OrganizationMember[]
  posRegisters                     PosRegister[]
  feedPosts                        Post[]                       @relation("OrganizationPosts")
  products                         Product[]
  productRequests                  ProductRequest[]
  servicePosts                     ServicePost[]
  serviceRequests                  ServiceRequest[]
  stockDispatches                  StockDispatch[]              @relation("OrganizationDispatches")
  stockRequestPayments             StockRequestPayment[]        @relation("OrganizationStockPayments")
  warehouseAssignments             WarehouseOrganization[]
  stockRequests                    WarehouseStockRequest[]      @relation("OrganizationStockRequests")
  dispatchReturns                  DispatchReturn[]             @relation("OrganizationReturns")
  joinRequests                     OrgJoinRequest[]             @relation("OrgJoinRequests")
  posShifts                        PosShift[]
  posSales                         PosSale[]
  posGoodsReceipts                 PosGoodsReceipt[]
  posCreditCustomers               PosCreditCustomer[]
  posCreditSales                   PosCreditSale[]
  posLoyaltyTransactions           PosLoyaltyTransaction[]
  restaurantDiscountSchedule       RestaurantDiscountSchedule?
  cafeDailyStocks                  CafeDailyStock[]
  cafeDailyStockReceipts           CafeDailyStockReceipt[]
  cafeRegularCustomers             CafeRegularCustomer[]
  restaurantMenuCategories         RestaurantMenuCategory[]
  restaurantTables                 RestaurantTable[]
  restaurantTickets                RestaurantTicket[]
  kitchenTickets                   KitchenTicket[]
  restaurantMealContracts          RestaurantMealContract[]
  restaurantMealCharges            RestaurantMealCharge[]
  contracts                        Contract[]
  productInteractions              ProductInteraction[]
  productInterestScores            ProductInterestScore[]
  productReviews                   ProductReview[]
  reels                            Reel[]
  reelInteractions                 ReelInteraction[]
  upgradePlans                     OrgUpgradePlan[]
  cardTerminalRequests             CardTerminalRequest[]
  gameScores                       OrganizationGameScore[]
  dailyActivities                  OrganizationDailyActivity[]
  deliveryPartnershipsRequested    DeliveryPartnership[]        @relation("DeliveryPartnershipRequester")
  deliveryPartnershipsProvided     DeliveryPartnership[]        @relation("DeliveryPartnershipProvider")
  warehouseCourierAssignments      WarehouseCourierAssignment[] @relation("CourierProviderOrganization")
  deliveryJobsRequested            Delivery[]                   @relation("DeliveryRequesterOrganization")
  deliveryJobsProvided             Delivery[]                   @relation("DeliveryProviderOrganization")
  salesVisitLocations              SalesVisitLocation[]         @relation("SalesLocationOwner")
  representedSalesLocations        SalesVisitLocation[]         @relation("SalesLocationVendor")
  salesVisits                      SalesVisit[]
  qualityChecklistTemplates        QualityChecklistTemplate[]
  qualityInspections               QualityInspection[]

  @@index([type])
  @@index([status])
  @@index([nameNormalized])
  @@index([deletedAt])
  @@index([scheduledPermanentDeletionAt])
  @@index([subdomainEnabled])
  workforcePulses WorkforcePulse[]
  workforceTrackingPreferences WorkforceTrackingPreference[]
  workforceLocationPoints WorkforceLocationPoint[]
  workforceMailCampaigns WorkforceMailCampaign[]
  workforceDepartments WorkforceDepartment[]
  workforceShifts WorkforceShift[]
  workforceAssignments WorkforceAssignment[]
  workforceRequests WorkforceRequest[]
  workforcePolicy WorkforcePolicy?
  workforceNotices WorkforceNotice[]
  workforceTokens WorkforceApiToken[]
  workforceAudit WorkforceAudit[]
  workforceSubscription WorkforceSubscription?
  workforceOrders WorkforceBillingOrder[]
}

model OrganizationDailyActivity {
  id             String       @id @default(uuid())
  organizationId String
  activityDate   DateTime     @db.Date
  activityCount  Int          @default(1)
  firstSeenAt    DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, activityDate])
  @@index([activityDate])
  @@index([organizationId, activityDate])
}

model OrganizationGameScore {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  game           String
  score          Int
  maxTile        Int          @default(0)
  moves          Int          @default(0)
  durationMs     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, game])
  @@index([organizationId, game, score])
  @@index([userId, game])
}

model CeoNotificationDelivery {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  type           String
  referenceKey   String
  sentAt         DateTime @default(now())

  @@unique([organizationId, userId, type, referenceKey])
  @@index([organizationId, sentAt])
  @@index([userId, sentAt])
}

model CardTerminalRequest {
  id                String                    @id @default(uuid())
  organizationId    String
  contactName       String
  contactPhone      String
  contactEmail      String?
  providerType      String // e.g. "MONPAY", "GOLOMT", "TDB", etc.
  businessNote      String?
  status            CardTerminalRequestStatus @default(PENDING)
  adminNote         String?
  // credentials set by admin after card terminal company approves
  cardTerminalId    String?
  terminalBridgeUrl String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy        User?                     @relation("CardTerminalRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model OrgUpgradePlan {
  id                  String            @id @default(uuid())
  organizationId      String
  planId              String?
  planType            String
  invoiceId           String            @unique
  invoiceNo           String            @unique
  qrText              String            @default("")
  deepLinks           Json?
  paymentProvider     String            @default("QPAY")
  paymentMerchantCode String?
  amount              Decimal           @db.Decimal(18, 2)
  status              PlanPaymentStatus @default(PENDING)
  paidAt              DateTime?
  expiresAt           DateTime?
  grantedByAdmin      Boolean           @default(false)
  grantNote           String?
  grantedById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                UpgradePlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@index([invoiceId])
  @@index([createdAt])
}

model UpgradePlan {
  id            String           @id @default(uuid())
  code          String           @unique
  name          String
  description   String?
  price         Decimal          @db.Decimal(18, 2)
  durationDays  Int
  maxProducts   Int
  maxImages     Int
