  restaurantTicket      RestaurantTicket?

  @@index([organizationId])
  @@index([branchId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([cafeRegularCustomerId])
  @@index([status])
  @@index([createdAt])
}

