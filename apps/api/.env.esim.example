# Server secrets only. Never copy credentials into Flutter/Dart defines.
ESIM_ACCESS_CODE=
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=
ESIM_QUOTE_SECRET=
# Leave false until ALL costs below have been confirmed. BPS: 100 = 1%.
ESIM_PRICING_REVIEWED=false
# Current company status: not VAT registered. Change after registration/review.
ESIM_VAT_BPS=0
# Required current FX, expires after 24 hours. ISO 8601 UTC timestamp.
ESIM_USD_MNT=
ESIM_FX_UPDATED_AT=
# Explicit values required; unknown costs must NOT silently become zero.
ESIM_INCOME_TAX_RESERVE_BPS=
ESIM_FUNDING_FEE_BPS=
ESIM_REFUND_RESERVE_BPS=
ESIM_SUPPLIER_TAX_BPS=
ESIM_OVERHEAD_PER_ORDER_MNT=
# Minu QR fee reserve 1%, profit markup 30%, rounding up to 100 MNT are server policy.

# eSIM purchasing: Minu Quick QR (SystemQR), not QPay/QuickQR.
# Obtain the subMerchant code AFTER registering the intended bank account in Minu.
ESIM_MINU_MERCHANT_CODE=
# Reuse server-owned Minu credentials. Never use the bank account number as a merchant code.
SYSTEMQR_USERNAME=
SYSTEMQR_PASSWORD=
API_PUBLIC_URL=https://mgl-api.onrender.com
# Separate random secrets: quote signing >=32 bytes; activation key base64 of 32 random bytes.
# Back up activation key securely. Losing it prevents decryption of issued profiles.
ESIM_ACTIVATION_KEY=
# Reviewed customer-facing terms, displayed and accepted before invoice creation.
ESIM_REFUND_TERMS=
# Enable worker first (requires migration), then checkout after readiness passes.
ESIM_WORKER_ENABLED=false
ESIM_CHECKOUT_ENABLED=false
# Member toggle uses active server-side membership; supplier cost converted to MNT
# and rounded up to 100. MGL bears payment/funding/tax costs in this at-cost mode.
