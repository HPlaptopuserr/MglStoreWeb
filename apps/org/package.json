    "kiosk:package": "powershell -NoProfile -ExecutionPolicy Bypass -File package-self-service-kiosk.ps1",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@mgl/types": "workspace:*",
    "@mgl/ui": "workspace:*",
    "clsx": "^2.1.1",
