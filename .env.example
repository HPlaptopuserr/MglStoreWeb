# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mglstore"

# API
API_URL="http://localhost:3001"
API_PUBLIC_URL="https://your-api-domain.example.com"

# Verify.mn
VERIFY_MN_API_KEY=""
VERIFY_MN_CALLBACK_URL="https://your-api-domain.example.com/auth/web/verify-mn/callback"

# SMTP email OTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="MGL Store <your-email@gmail.com>"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
