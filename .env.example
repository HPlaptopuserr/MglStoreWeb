# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mglstore"

# API
API_URL="http://localhost:3001"
API_PUBLIC_URL="https://your-api-domain.example.com"
JWT_SECRET="change-me-in-development"

# Supabase Storage (product/vendor images)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Verify.mn
VERIFY_MN_API_KEY=""
VERIFY_MN_CALLBACK_URL="https://your-api-domain.example.com/auth/web/verify-mn/callback"

# Minu POS Agent
# Store-specific Minu username/password/branchId are saved from Vendor -> Profile -> Merchant settings.
MINU_AGENT_BASE_URL="https://api.minu.mn"

# Push ECR / PayPRO card terminal provider
PUSH_ECR_BASE_URL="https://push.easypay.mn:8443"
PUSH_ECR_API_KEY=""
PUSH_ECR_CLIENT_ID=""
PUSH_ECR_TERMINAL_ID=""

# Minu Dynamic QR / QR payment
# Use -test endpoints for staging, remove -test for production after Minu approves live credentials.
SYSTEMQR_ROOT_URL="https://api.minu.mn"
SYSTEMQR_BASE_URL="https://api.minu.mn/qrpay-test"
SYSTEMQR_DEEPLINK_URL="https://api.minu.mn/deeplink-test"
SYSTEMQR_USERNAME=""
SYSTEMQR_PASSWORD=""

# QPay QuickQR master account (required only for Vendor -> QPay -> "Шинээр бүртгүүлэх")
QPAY_QUICKQR_BASE_URL=""
QPAY_QUICKQR_MASTER_USERNAME=""
QPAY_QUICKQR_MASTER_PASSWORD=""
QPAY_QUICKQR_MASTER_TERMINAL_ID=""

# MglStore Pro Upgrade QPay (one platform-owned settlement account)
# Keep these server-side. If all three are blank, the shared QPAY_CLIENT_ID,
# QPAY_CLIENT_SECRET and QPAY_INVOICE_CODE values are used for compatibility.
QPAY_BASE_URL="https://merchant.qpay.mn/v2"
QPAY_CLIENT_ID=""
QPAY_CLIENT_SECRET=""
QPAY_INVOICE_CODE=""
QPAY_UPGRADE_CLIENT_ID=""
QPAY_UPGRADE_CLIENT_SECRET=""
QPAY_UPGRADE_INVOICE_CODE=""

# POS local bridge / Android PGW USB terminal
POS_BRIDGE_CHARGE_TIMEOUT_MS="120000"
# Use the same secret in API POS_BRIDGE_SHARED_SECRET and local bridge BRIDGE_SHARED_SECRET when enabling signing.
POS_BRIDGE_SHARED_SECRET=""
BRIDGE_PORT="7420"
BRIDGE_PROVIDER="android-pgw"
ANDROID_PGW_PORT="auto"
ANDROID_PGW_BAUD_RATE="9600"
ANDROID_PGW_DATA_BITS="8"
ANDROID_PGW_STOP_BITS="1"
ANDROID_PGW_PARITY="none"
ANDROID_PGW_TIMEOUT_MS="120000"
ANDROID_PGW_HEALTH_TIMEOUT_MS="4000"
ANDROID_PGW_RESPONSE_IDLE_MS="700"
# Android PGW amount multiplier. Keep 100 for Android PGW unless the terminal displays scaled amounts.
ANDROID_PGW_AMOUNT_MULTIPLIER="100"
ANDROID_PGW_APPEND_CRLF="false"

# eBarimt local PosAPI (cashier PC)
# Vendor browser calls this local service after payment succeeds.
NEXT_PUBLIC_EBARIMT_POS_API_URL="http://localhost:7080"
NEXT_PUBLIC_EBARIMT_BRANCH_NO="001"
NEXT_PUBLIC_EBARIMT_DISTRICT_CODE="0101"
NEXT_PUBLIC_EBARIMT_CLASSIFICATION_CODE="4711000"

# SMTP email OTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="MGL Store <your-email@gmail.com>"
SMTP_TIMEOUT_MS="15000"
EMAIL_SEND_ATTEMPTS="2"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Meta Ads / Commerce
# Browser Pixel ID is public by design. Keep the Conversions API token server-only.
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CONVERSIONS_API_TOKEN=""
META_GRAPH_API_VERSION=""
META_TEST_EVENT_CODE=""
META_CATALOG_FEED_TOKEN=""
MGL_WEB_PUBLIC_URL="https://mglstore.mn"

# eBarimt local PosAPI integration is disabled by default.
# Set this global gate to true only after operator approval. Each POS register
# still needs eBarimt enabled and merchant/posNo configured from the admin panel.
NEXT_PUBLIC_EBARIMT_ENABLED="false"
NEXT_PUBLIC_EBARIMT_POS_API_URL="http://localhost:7080"
NEXT_PUBLIC_EBARIMT_BRANCH_NO="001"
NEXT_PUBLIC_EBARIMT_DISTRICT_CODE="0101"
NEXT_PUBLIC_EBARIMT_CLASSIFICATION_CODE="4711000"
# Optional procurement AI. Without a key the API uses its deterministic smart fallback.
OPENAI_API_KEY=
OPENAI_PROCUREMENT_MODEL=gpt-5.6-luna
