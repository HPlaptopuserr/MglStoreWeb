# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mglstore"

# API
API_URL="http://localhost:3001"
API_PUBLIC_URL="https://your-api-domain.example.com"
JWT_SECRET="change-me-in-development"

# Verify.mn
VERIFY_MN_API_KEY=""
VERIFY_MN_CALLBACK_URL="https://your-api-domain.example.com/auth/web/verify-mn/callback"

# Minu POS Agent
# Store-specific Minu username/password/branchId are saved from Vendor -> Profile -> Merchant settings.
MINU_AGENT_BASE_URL="https://api.minu.mn"

# POS local bridge / Android PGW USB terminal
POS_BRIDGE_CHARGE_TIMEOUT_MS="120000"
# Use the same secret in API POS_BRIDGE_SHARED_SECRET and local bridge BRIDGE_SHARED_SECRET when enabling signing.
POS_BRIDGE_SHARED_SECRET=""
BRIDGE_PORT="7420"
BRIDGE_PROVIDER="android-pgw"
ANDROID_PGW_PORT="auto"
ANDROID_PGW_BAUD_RATE="9600"
ANDROID_PGW_DATA_BITS="8"
ANDROID_PGW_STOP_BITS="1"
ANDROID_PGW_PARITY="none"
ANDROID_PGW_TIMEOUT_MS="120000"
ANDROID_PGW_HEALTH_TIMEOUT_MS="4000"
ANDROID_PGW_RESPONSE_IDLE_MS="700"
# Android PGW amount multiplier. Keep 100 for Android PGW unless the terminal displays scaled amounts.
ANDROID_PGW_AMOUNT_MULTIPLIER="100"
ANDROID_PGW_APPEND_CRLF="false"

# SMTP email OTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="MGL Store <your-email@gmail.com>"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
